# Customer-specific artifacts — never commit
customers/
*-customer.md
*-filled.xlsx
*-filled.docx

# Office / OS temp
~$*
*.tmp
*.log

# Working dumps from the workbook
_workbook_dump/

# Captured config artifacts (Get-VCFDeploymentArtifacts.ps1) — even sanitized,
# these describe a real environment; keep them out of the public repo
artifacts/
.raw/

# Generated at build time from tools/*.ps1 (see web/package.json prebuild)
web/public/scripts/

# Downloaded Broadcom API spec bundles (large, third-party, not the pinned
# workbook — used as a research reference, never committed)
research/

# Claude Code: personal, per-machine settings. The shared .claude/settings.json is
# committed on purpose (#360); this one never is.
.claude/settings.local.json
