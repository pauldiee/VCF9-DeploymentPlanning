---
import '../styles/site.css';
import Sidebar from '../components/Sidebar.astro';
import { withBase } from '../lib/path';
import { siteVersion } from '../lib/version';
import { navFlowItems, navReferenceBands, navBySlug } from '../nav';
import { docHref as href } from '../lib/path';

interface Props {
  title: string;
  description?: string;
  /** Slug of the active doc, for nav highlighting and the breadcrumb. Omit on the landing page. */
  active?: string;
  /** Landing/tool pages that don't want the standard content max-width. */
  fullWidth?: boolean;
}

const { title, description, active, fullWidth = false } = Astro.props;
const asset = withBase;
const repoUrl = 'https://github.com/pauldiee/VCF9-DeploymentPlanning';
const feedbackUrl =
  `${repoUrl}/issues/new?template=site-feedback.yml` +
  `&page=${encodeURIComponent(Astro.url.pathname)}` +
  `&version=${encodeURIComponent(siteVersion)}`;

const flowItems = navFlowItems();
const referenceBands = navReferenceBands();
const meta = active ? navBySlug(active) : undefined;
const sizerHref = withBase('tools/mgmt-sizing/');
const planExportHref = withBase('tools/deployment-plan/');
const planTrackerHref = withBase('tools/plan-tracker/');
const testPlanHref = withBase('tools/test-plan/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Before first paint: apply a stored theme choice so the page never
        flashes the wrong scheme. No stored choice means no attribute, and
        prefers-color-scheme decides. (#233) */}
    <script is:inline>
      try {
        var t = localStorage.getItem('itq-theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch (e) {
        /* private mode / storage blocked: fall back to the media query */
      }
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={asset('itq/assets/logo/itq-glasses-clean.svg')} />
    <link rel="stylesheet" href={asset('itq/styles.css')} />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      referrerpolicy="no-referrer"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-header__brand" href={asset('')} aria-label="ITQ home">
          <img
            class="site-header__logo--light"
            src={asset('itq/assets/logo/itq-logo-primary.png')}
            alt=""
            height="30"
            aria-hidden="true"
          />
          <img
            class="site-header__logo--dark"
            src={asset('itq/assets/logo/itq-logo-white.png')}
            alt=""
            height="30"
            aria-hidden="true"
          />
          <span class="site-header__divider" aria-hidden="true"></span>
          <span class="site-header__product">VCF 9 Deployment Planning and Operations</span>
        </a>

        <nav class="nav-primary" aria-label="Primary">
          <div class="nav-item">
            <button type="button" class="nav-trigger">
              Planning Flow <i class="fa-solid fa-chevron-down nav-chev" aria-hidden="true"></i>
            </button>
            <div class="nav-panel nav-panel--flow">
              <ul class="flow-list">
                {
                  flowItems.map((item) => (
                    <li>
                      <a
                        class:list={['flow-link', { 'is-active': active === item.slug }]}
                        href={href(item.slug)}
                      >
                        <i class={`fa-solid fa-${item.icon}`} aria-hidden="true" />
                        <span>
                          <span class="flow-step">{item.step}</span>
                          <span class="flow-label">{item.label}</span>
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>

          <div class="nav-item">
            <button type="button" class="nav-trigger">
              Reference <i class="fa-solid fa-chevron-down nav-chev" aria-hidden="true"></i>
            </button>
            <div class="nav-panel nav-panel--reference">
              <div class="ref-grid">
                {
                  referenceBands.map((group) => (
                    <div class="ref-band">
                      <h4>{group.band}</h4>
                      <ul>
                        {group.items.map((item) => (
                          <li>
                            <a
                              class:list={['ref-link', { 'is-active': active === item.slug }]}
                              href={href(item.slug)}
                            >
                              <i class={`fa-solid fa-${item.icon}`} aria-hidden="true" />
                              {item.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          <div class="nav-item">
            <button type="button" class="nav-trigger">
              Tools <i class="fa-solid fa-chevron-down nav-chev" aria-hidden="true"></i>
            </button>
            <div class="nav-panel nav-panel--tools">
              <div class="ref-band">
                <ul>
                  <li>
                    <a class:list={['ref-link', { 'is-active': active === 'tools/mgmt-sizing' }]} href={sizerHref}>
                      <i class="fa-solid fa-calculator" aria-hidden="true" /> Sizing Calculator
                    </a>
                  </li>
                  <li>
                    <a
                      class:list={['ref-link', { 'is-active': active === 'tools/deployment-plan' }]}
                      href={planExportHref}
                    >
                      <i class="fa-solid fa-sitemap" aria-hidden="true" /> Deployment Plan Export
                    </a>
                  </li>
                  <li>
                    <a
                      class:list={['ref-link', { 'is-active': active === 'tools/plan-tracker' }]}
                      href={planTrackerHref}
                    >
                      <i class="fa-solid fa-bars-progress" aria-hidden="true" /> Deployment Tracker
                    </a>
                  </li>
                  <li>
                    <a class:list={['ref-link', { 'is-active': active === 'tools/test-plan' }]} href={testPlanHref}>
                      <i class="fa-solid fa-clipboard-check" aria-hidden="true" /> Test Plan
                    </a>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <a
            class:list={['nav-plain', { 'is-active': active === 'version-overview' }]}
            href={withBase('version-overview/')}
          >
            Versions
          </a>
        </nav>

        <button type="button" class="hamburger" id="mobileNavToggle" aria-label="Open menu" aria-expanded="false">
          <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>

        <div class="header-actions">
          <a class="icon-btn" href={asset('search/')} title="Search docs">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          </a>
          <button
            type="button"
            id="themeToggle"
            class="icon-btn theme-toggle"
            title="Switch between light and dark"
            aria-label="Switch between light and dark"
          >
            <i class="fa-solid fa-sun" aria-hidden="true"></i>
            <i class="fa-solid fa-moon" aria-hidden="true"></i>
          </button>
          <a
            class="header-version"
            href={`${repoUrl}/blob/main/CHANGELOG.md`}
            target="_blank"
            rel="noopener"
            title="What changed in this release"
          >
            {siteVersion}
          </a>
          <a class="header-feedback icon-btn" href={feedbackUrl} target="_blank" rel="noopener" title="Feedback">
            <i class="fa-solid fa-comment-dots" aria-hidden="true"></i>
          </a>
          <a
            class="icon-btn"
            href="https://www.hollebollevsan.nl"
            target="_blank"
            rel="noopener"
            title="Blog"
          >
            <i class="fa-solid fa-pen-nib" aria-hidden="true"></i>
          </a>
          <a class="icon-btn" href={repoUrl} target="_blank" rel="noopener" title="GitHub">
            <i class="fa-brands fa-github" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      {/* Mobile fallback (<900px): the hamburger toggles this instead of the
          desktop mega-menu, reusing the same nav data via <Sidebar>. */}
      <div class="mobile-nav" id="mobileNav">
        <Sidebar active={active} />
        <div class="mobile-nav__more">
          <a href={asset('search/')}><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Search</a>
          <a href={`${repoUrl}/blob/main/CHANGELOG.md`} target="_blank" rel="noopener">
            <i class="fa-solid fa-code-branch" aria-hidden="true"></i> {siteVersion}
          </a>
          <a href={feedbackUrl} target="_blank" rel="noopener">
            <i class="fa-solid fa-comment-dots" aria-hidden="true"></i> Feedback
          </a>
          <a href="https://www.hollebollevsan.nl" target="_blank" rel="noopener">
            <i class="fa-solid fa-pen-nib" aria-hidden="true"></i> Blog
          </a>
          <a href={repoUrl} target="_blank" rel="noopener">
            <i class="fa-brands fa-github" aria-hidden="true"></i> GitHub
          </a>
        </div>
      </div>
    </header>

    {
      meta && (
        <nav class="breadcrumb" aria-label="Breadcrumb">
          {meta.band ? (
            <>
              <span>Reference</span>
              <i class="fa-solid fa-chevron-right" aria-hidden="true" />
              <span>{meta.band}</span>
              <i class="fa-solid fa-chevron-right" aria-hidden="true" />
              <span class="breadcrumb__current">{meta.label}</span>
            </>
          ) : (
            <>
              <span>Planning Flow</span>
              <i class="fa-solid fa-chevron-right" aria-hidden="true" />
              <span class="breadcrumb__current">{meta.label}</span>
            </>
          )}
        </nav>
      )
    }

    <div class:list={['layout', { 'layout--full': fullWidth }]}>
      <main id="main" class:list={['content', { 'content--full': fullWidth }]} data-pagefind-body>
        <slot />
      </main>
    </div>

    <p class="colophon">
      <strong>ITQ &ndash; What's Next.</strong> VCF 9.1 deployment-planning and operations helper material.
      &copy; 2026 Paul van Dieen. <a href="https://hollebollevsan.nl" target="_blank" rel="noopener">hollebollevsan.nl</a>
    </p>

    {/* The toggle sets an explicit choice that wins over prefers-color-scheme
        in both directions, and remembers it. The icons themselves are swapped
        by CSS, so nothing here has to touch them. (#233) */}
    <script is:inline>
      (function () {
        var btn = document.getElementById('themeToggle');
        if (!btn) return;
        var root = document.documentElement;
        var media = window.matchMedia('(prefers-color-scheme: dark)');
        function current() {
          return root.dataset.theme || (media.matches ? 'dark' : 'light');
        }
        function label() {
          btn.setAttribute(
            'aria-label',
            current() === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'
          );
          btn.setAttribute('title', btn.getAttribute('aria-label'));
        }
        btn.addEventListener('click', function () {
          var next = current() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('itq-theme', next);
          } catch (e) {
            /* storage blocked: the choice just doesn't survive the page */
          }
          label();
        });
        media.addEventListener('change', label);
        label();
      })();
    </script>

    {/* Mobile menu toggle: shows/hides the reused Sidebar content below the
        header at <900px. Desktop hides both the button and the panel via CSS
        regardless of this class, so it's a no-op above the breakpoint. */}
    <script is:inline>
      (function () {
        var btn = document.getElementById('mobileNavToggle');
        var panel = document.getElementById('mobileNav');
        if (!btn || !panel) return;
        btn.addEventListener('click', function () {
          var open = panel.classList.toggle('is-open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          btn.querySelector('i').className = open ? 'fa-solid fa-xmark' : 'fa-solid fa-bars';
        });
      })();
    </script>

    {/* Adds a copy button to every <pre><code> block in rendered doc/sample
        content. Icon swaps to a checkmark for ~1.5s on copy as feedback. */}
    <script is:inline>
      (function () {
        var COPY_ICON =
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
        var CHECK_ICON =
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
        var blocks = document.querySelectorAll('.prose pre');
        blocks.forEach(function (pre) {
          if (pre.querySelector('.code-copy-btn')) return;
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'code-copy-btn';
          btn.setAttribute('aria-label', 'Copy code');
          btn.innerHTML = COPY_ICON;
          btn.addEventListener('click', function () {
            var code = pre.querySelector('code');
            var text = (code || pre).innerText;
            var done = function () {
              btn.innerHTML = CHECK_ICON;
              btn.classList.add('is-copied');
              btn.setAttribute('aria-label', 'Copied');
              setTimeout(function () {
                btn.innerHTML = COPY_ICON;
                btn.classList.remove('is-copied');
                btn.setAttribute('aria-label', 'Copy code');
              }, 1500);
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(text).then(done, function () {
                /* clipboard blocked (e.g. insecure context) — no feedback */
              });
            }
          });
          pre.appendChild(btn);
        });
      })();
    </script>
  </body>
</html>
