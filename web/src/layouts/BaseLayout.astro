---
import '../styles/site.css';
import Sidebar from '../components/Sidebar.astro';
import { withBase } from '../lib/path';
import { siteVersion } from '../lib/version';
import { navFlowItems, navReferenceBands, navBySlug } from '../nav';
import { docHref as href } from '../lib/path';

interface Props {
  title: string;
  description?: string;
  /** Slug of the active doc, for nav highlighting and the breadcrumb. Omit on the landing page. */
  active?: string;
  /** Landing/tool pages that don't want the standard content max-width. */
  fullWidth?: boolean;
  /** Page language. English is the default; 'nl' is the Dutch translation pilot (#290). */
  lang?: 'en' | 'nl';
  /** This same page in the other language, when one exists. Drives the header language toggle. */
  altHref?: string;
}

const { title, description, active, fullWidth = false, lang = 'en', altHref } = Astro.props;
// The toggle only exists on a page that has a counterpart in the other
// language (altHref); a page without one shows no toggle at all.
const otherLang = lang === 'nl' ? 'en' : 'nl';
const langToggleTitle = lang === 'nl' ? 'Switch to English' : 'Nederlands';
// Only an English page with a real Dutch counterpart honours a stored "nl" choice.
const nlCounterpart = lang === 'en' ? altHref : undefined;
const nlRoot = withBase('nl/');
const asset = withBase;
const repoUrl = 'https://github.com/pauldiee/VCF9-DeploymentPlanning';
const feedbackUrl =
  `${repoUrl}/issues/new?template=site-feedback.yml` +
  `&page=${encodeURIComponent(Astro.url.pathname)}` +
  `&version=${encodeURIComponent(siteVersion)}`;

const flowItems = navFlowItems();
const referenceBands = navReferenceBands();
const meta = active ? navBySlug(active) : undefined;
const sizerHref = withBase('tools/mgmt-sizing/');
const opsLogsSizerHref = withBase('tools/ops-logs-sizing/');
const planExportHref = withBase('tools/deployment-plan/');
const planTrackerHref = withBase('tools/plan-tracker/');
const testPlanHref = withBase('tools/test-plan/');
const sampleHref = withBase('samples/01-network-dns-plan-rainpole/');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Language (pilot, #290). First visit is always English. A reader who chose
        Dutch with the header toggle is sent to the Dutch version of a page that
        has one, before first paint. Not when they arrived from a Dutch page:
        following a link to the English original is a deliberate choice. */}
    {
      nlCounterpart && (
        <script is:inline define:vars={{ nlCounterpart, nlRoot }}>
          try {
            if (localStorage.getItem('itq-lang') === 'nl') {
              var fromNl = false;
              try {
                var ref = document.referrer ? new URL(document.referrer) : null;
                fromNl = !!ref && ref.host === location.host && ref.pathname.indexOf(nlRoot) === 0;
              } catch (e) {
                /* unparseable referrer: treat as not from a Dutch page */
              }
              if (!fromNl) location.replace(nlCounterpart + location.hash);
            }
          } catch (e) {
            /* storage blocked: stay on the English page */
          }
        </script>
      )
    }
    {altHref && <link rel="alternate" hreflang={otherLang} href={altHref} />}
    {/* Before first paint: apply a stored theme choice so the page never
        flashes the wrong scheme. No stored choice means no attribute, and
        prefers-color-scheme decides. (#233) */}
    <script is:inline>
      try {
        var t = localStorage.getItem('itq-theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch (e) {
        /* private mode / storage blocked: fall back to the media query */
      }
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={asset('itq/assets/logo/itq-glasses-clean.svg')} />
    <link rel="stylesheet" href={asset('itq/styles.css')} />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      referrerpolicy="no-referrer"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-header__brand" href={asset('')} aria-label="ITQ home">
          <img
            class="site-header__logo--light"
            src={asset('itq/assets/logo/itq-logo-primary.png')}
            alt=""
            height="30"
            aria-hidden="true"
          />
          <img
            class="site-header__logo--dark"
            src={asset('itq/assets/logo/itq-logo-white.png')}
            alt=""
            height="30"
            aria-hidden="true"
          />
          <span class="site-header__divider" aria-hidden="true"></span>
          <span class="site-header__product">VCF 9 Deployment Planning and Operations</span>
        </a>

        <nav class="nav-primary" aria-label="Primary">
          <div class="nav-item">
            <button type="button" class="nav-trigger">
              Planning Flow <i class="fa-solid fa-chevron-down nav-chev" aria-hidden="true"></i>
            </button>
            <div class="nav-panel nav-panel--flow">
              <ul class="flow-list">
                {
                  flowItems.map((item) => (
                    <li>
                      <a
                        class:list={['flow-link', { 'is-active': active === item.slug }]}
                        href={href(item.slug)}
                      >
                        <i class={`fa-solid fa-${item.icon}`} aria-hidden="true" />
                        <span>
                          <span class="flow-step">{item.step}</span>
                          <span class="flow-label">{item.label}</span>
                        </span>
                      </a>
                    </li>
                  ))
                }
                <li>
                  <a class="flow-link" href={sampleHref}>
                    <i class="fa-solid fa-file-lines" aria-hidden="true" />
                    <span>
                      <span class="flow-step">Rainpole</span>
                      <span class="flow-label">Worked Step 1 plan</span>
                    </span>
                  </a>
                </li>
              </ul>
            </div>
          </div>

          <div class="nav-item">
            <button type="button" class="nav-trigger">
              Reference <i class="fa-solid fa-chevron-down nav-chev" aria-hidden="true"></i>
            </button>
            <div class="nav-panel nav-panel--reference">
              <div class="ref-grid">
                {
                  referenceBands.map((group) => (
                    <div class="ref-band">
                      <h4>{group.band}</h4>
                      <ul>
                        {group.items.map((item) => (
                          <li>
                            <a
                              class:list={['ref-link', { 'is-active': active === item.slug }]}
                              href={href(item.slug)}
                            >
                              <i class={`fa-solid fa-${item.icon}`} aria-hidden="true" />
                              {item.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          <div class="nav-item">
            <button type="button" class="nav-trigger">
              Tools <i class="fa-solid fa-chevron-down nav-chev" aria-hidden="true"></i>
            </button>
            <div class="nav-panel nav-panel--tools">
              <div class="ref-band">
                <ul>
                  <li>
                    <a class:list={['ref-link', { 'is-active': active === 'tools/mgmt-sizing' }]} href={sizerHref}>
                      <i class="fa-solid fa-calculator" aria-hidden="true" /> Sizing Calculator
                    </a>
                  </li>
                  <li>
                    <a
                      class:list={['ref-link', { 'is-active': active === 'tools/ops-logs-sizing' }]}
                      href={opsLogsSizerHref}
                    >
                      <i class="fa-solid fa-chart-line" aria-hidden="true" /> Ops &amp; Logs Planning Sizer
                    </a>
                  </li>
                  <li>
                    <a
                      class:list={['ref-link', { 'is-active': active === 'tools/deployment-plan' }]}
                      href={planExportHref}
                    >
                      <i class="fa-solid fa-sitemap" aria-hidden="true" /> Deployment Plan Export
                    </a>
                  </li>
                  <li>
                    <a
                      class:list={['ref-link', { 'is-active': active === 'tools/plan-tracker' }]}
                      href={planTrackerHref}
                    >
                      <i class="fa-solid fa-bars-progress" aria-hidden="true" /> Deployment Tracker
                    </a>
                  </li>
                  <li>
                    <a class:list={['ref-link', { 'is-active': active === 'tools/test-plan' }]} href={testPlanHref}>
                      <i class="fa-solid fa-clipboard-check" aria-hidden="true" /> Test Plan
                    </a>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <a
            class:list={['nav-plain', { 'is-active': active === 'version-overview' }]}
            href={withBase('version-overview/')}
          >
            Versions
          </a>
        </nav>

        <button type="button" class="hamburger" id="mobileNavToggle" aria-label="Open menu" aria-expanded="false">
          <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>

        <div class="header-actions">
          <a class="icon-btn" href={asset('search/')} title="Search docs">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          </a>
          <button
            type="button"
            id="themeToggle"
            class="icon-btn theme-toggle"
            title="Switch between light and dark"
            aria-label="Switch between light and dark"
          >
            <i class="fa-solid fa-sun" aria-hidden="true"></i>
            <i class="fa-solid fa-moon" aria-hidden="true"></i>
          </button>
          {
            altHref && (
              <a
                id="langToggle"
                class="icon-btn lang-toggle"
                href={altHref}
                hreflang={otherLang}
                data-lang={otherLang}
                title={langToggleTitle}
                aria-label={langToggleTitle}
              >
                {otherLang.toUpperCase()}
              </a>
            )
          }
          <a
            class="header-version"
            href={`${repoUrl}/blob/main/CHANGELOG.md`}
            target="_blank"
            rel="noopener"
            title="What changed in this release"
          >
            {siteVersion}
          </a>
          <a class="header-feedback icon-btn" href={feedbackUrl} target="_blank" rel="noopener" title="Feedback">
            <i class="fa-solid fa-comment-dots" aria-hidden="true"></i>
          </a>
          <a
            class="icon-btn"
            href="https://www.hollebollevsan.nl"
            target="_blank"
            rel="noopener"
            title="Blog"
          >
            <i class="fa-solid fa-pen-nib" aria-hidden="true"></i>
          </a>
          <a class="icon-btn" href={repoUrl} target="_blank" rel="noopener" title="GitHub">
            <i class="fa-brands fa-github" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      {/* Mobile fallback (<900px): the hamburger toggles this instead of the
          desktop mega-menu, reusing the same nav data via <Sidebar>. */}
      <div class="mobile-nav" id="mobileNav">
        <Sidebar active={active} />
        <div class="mobile-nav__more">
          <a href={asset('search/')}><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Search</a>
          <a href={`${repoUrl}/blob/main/CHANGELOG.md`} target="_blank" rel="noopener">
            <i class="fa-solid fa-code-branch" aria-hidden="true"></i> {siteVersion}
          </a>
          <a href={feedbackUrl} target="_blank" rel="noopener">
            <i class="fa-solid fa-comment-dots" aria-hidden="true"></i> Feedback
          </a>
          <a href="https://www.hollebollevsan.nl" target="_blank" rel="noopener">
            <i class="fa-solid fa-pen-nib" aria-hidden="true"></i> Blog
          </a>
          <a href={repoUrl} target="_blank" rel="noopener">
            <i class="fa-brands fa-github" aria-hidden="true"></i> GitHub
          </a>
        </div>
      </div>
    </header>

    {
      meta && (
        <nav class="breadcrumb" aria-label="Breadcrumb">
          {meta.band ? (
            <>
              <span>Reference</span>
              <i class="fa-solid fa-chevron-right" aria-hidden="true" />
              <span>{meta.band}</span>
              <i class="fa-solid fa-chevron-right" aria-hidden="true" />
              <span class="breadcrumb__current">{meta.label}</span>
            </>
          ) : (
            <>
              <span>Planning Flow</span>
              <i class="fa-solid fa-chevron-right" aria-hidden="true" />
              <span class="breadcrumb__current">{meta.label}</span>
            </>
          )}
        </nav>
      )
    }

    <div class:list={['layout', { 'layout--full': fullWidth }]}>
      <main id="main" class:list={['content', { 'content--full': fullWidth }]} data-pagefind-body>
        <slot />
      </main>
    </div>

    <p class="colophon">
      <strong>ITQ &ndash; What's Next.</strong> VCF 9.1 deployment-planning and operations helper material.
      &copy; 2026 Paul van Dieen. <a href="https://hollebollevsan.nl" target="_blank" rel="noopener">hollebollevsan.nl</a>
    </p>

    {/* The toggle sets an explicit choice that wins over prefers-color-scheme
        in both directions, and remembers it. The icons themselves are swapped
        by CSS, so nothing here has to touch them. (#233) */}
    <script is:inline>
      (function () {
        var btn = document.getElementById('themeToggle');
        if (!btn) return;
        var root = document.documentElement;
        var media = window.matchMedia('(prefers-color-scheme: dark)');
        function current() {
          return root.dataset.theme || (media.matches ? 'dark' : 'light');
        }
        function label() {
          btn.setAttribute(
            'aria-label',
            current() === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'
          );
          btn.setAttribute('title', btn.getAttribute('aria-label'));
        }
        btn.addEventListener('click', function () {
          var next = current() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('itq-theme', next);
          } catch (e) {
            /* storage blocked: the choice just doesn't survive the page */
          }
          label();
        });
        media.addEventListener('change', label);
        label();
      })();
    </script>

    {/* Language toggle (pilot, #290): an ordinary link to the other language,
        so it works without script. The script only remembers the choice. */}
    <script is:inline>
      (function () {
        var link = document.getElementById('langToggle');
        if (!link) return;
        link.addEventListener('click', function () {
          try {
            localStorage.setItem('itq-lang', link.dataset.lang);
          } catch (e) {
            /* storage blocked: the choice just doesn't survive the page */
          }
        });
      })();
    </script>

    {/* Mobile menu toggle: shows/hides the reused Sidebar content below the
        header at <900px. Desktop hides both the button and the panel via CSS
        regardless of this class, so it's a no-op above the breakpoint. */}
    <script is:inline>
      (function () {
        var btn = document.getElementById('mobileNavToggle');
        var panel = document.getElementById('mobileNav');
        if (!btn || !panel) return;
        btn.addEventListener('click', function () {
          var open = panel.classList.toggle('is-open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          btn.querySelector('i').className = open ? 'fa-solid fa-xmark' : 'fa-solid fa-bars';
        });
      })();
    </script>

    {/* Adds a copy button to every <pre><code> block in rendered doc/sample
        content. Icon swaps to a checkmark for ~1.5s on copy as feedback. */}
    <script is:inline>
      (function () {
        var COPY_ICON =
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
        var CHECK_ICON =
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
        var blocks = document.querySelectorAll('.prose pre');
        blocks.forEach(function (pre) {
          if (pre.querySelector('.code-copy-btn')) return;
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'code-copy-btn';
          btn.setAttribute('aria-label', 'Copy code');
          btn.innerHTML = COPY_ICON;
          btn.addEventListener('click', function () {
            var code = pre.querySelector('code');
            var text = (code || pre).innerText;
            var done = function () {
              btn.innerHTML = CHECK_ICON;
              btn.classList.add('is-copied');
              btn.setAttribute('aria-label', 'Copied');
              setTimeout(function () {
                btn.innerHTML = COPY_ICON;
                btn.classList.remove('is-copied');
                btn.setAttribute('aria-label', 'Copy code');
              }, 1500);
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(text).then(done, function () {
                /* clipboard blocked (e.g. insecure context) — no feedback */
              });
            }
          });
          pre.appendChild(btn);
        });
      })();
    </script>

    {/* Lightbox: an image in rendered doc content (.prose img) opens large in
        an overlay, like the WordPress lightbox. An image already wrapped in a
        link to an image file (PNG shown, SVG linked) opens the link target;
        a link to anything else is left alone. Ctrl/Cmd/Shift/middle click
        still follow the link. Esc, the close button or a click next to the
        image closes it; arrow keys step through the page's images; a click
        on the image toggles a 2x zoom with scrolling. (#483) */}
    <script is:inline>
      (function () {
        var IMG_EXT = /\.(svg|png|jpe?g|gif|webp|avif)(?:[?#].*)?$/i;
        var items = [];
        document.querySelectorAll('.prose img').forEach(function (img) {
          var a = img.closest('a');
          if (a) {
            if (!IMG_EXT.test(a.getAttribute('href') || '')) return;
            items.push({ img: img, src: a.href, trigger: a });
          } else {
            img.tabIndex = 0;
            img.setAttribute('role', 'button');
            items.push({ img: img, src: img.currentSrc || img.src, trigger: img });
          }
        });
        if (!items.length) return;

        var box = document.createElement('div');
        box.className = 'lightbox';
        box.hidden = true;
        box.setAttribute('role', 'dialog');
        box.setAttribute('aria-modal', 'true');
        box.setAttribute('aria-label', 'Image viewer');
        box.setAttribute('data-pagefind-ignore', '');
        box.innerHTML =
          '<div class="lightbox__bar">' +
          '<span class="lightbox__count" aria-live="polite"></span>' +
          '<a class="lightbox__btn lightbox__open" target="_blank" rel="noopener" aria-label="Open the image in a new tab" title="Open in a new tab"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>' +
          '<button type="button" class="lightbox__btn lightbox__close" aria-label="Close (Esc)" title="Close (Esc)"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>' +
          '</div>' +
          '<button type="button" class="lightbox__nav lightbox__prev" aria-label="Previous image"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>' +
          '<div class="lightbox__stage"><img class="lightbox__img" alt="" /></div>' +
          '<button type="button" class="lightbox__nav lightbox__next" aria-label="Next image"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>';
        document.body.appendChild(box);

        var stage = box.querySelector('.lightbox__stage');
        var big = box.querySelector('.lightbox__img');
        var count = box.querySelector('.lightbox__count');
        var openLink = box.querySelector('.lightbox__open');
        var closeBtn = box.querySelector('.lightbox__close');
        var prevBtn = box.querySelector('.lightbox__prev');
        var nextBtn = box.querySelector('.lightbox__next');
        var current = -1;
        var lastFocus = null;

        function show(i) {
          current = (i + items.length) % items.length;
          var it = items[current];
          stage.classList.remove('is-zoomed');
          big.style.width = '';
          stage.scrollTop = 0;
          stage.scrollLeft = 0;
          big.src = it.src;
          big.alt = it.img.alt || '';
          openLink.href = it.src;
          count.textContent = items.length > 1 ? current + 1 + ' / ' + items.length : '';
        }
        function open(i) {
          lastFocus = document.activeElement;
          prevBtn.hidden = nextBtn.hidden = items.length < 2;
          show(i);
          box.hidden = false;
          document.documentElement.classList.add('lightbox-open');
          closeBtn.focus();
        }
        function close() {
          box.hidden = true;
          big.removeAttribute('src');
          document.documentElement.classList.remove('lightbox-open');
          if (lastFocus && lastFocus.focus) lastFocus.focus();
        }

        items.forEach(function (it, i) {
          it.trigger.addEventListener('click', function (e) {
            if (e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
            e.preventDefault();
            open(i);
          });
          if (it.trigger === it.img) {
            it.img.addEventListener('keydown', function (e) {
              if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                open(i);
              }
            });
          }
        });

        closeBtn.addEventListener('click', close);
        prevBtn.addEventListener('click', function () { show(current - 1); });
        nextBtn.addEventListener('click', function () { show(current + 1); });
        big.addEventListener('click', function () {
          // Zoom to twice the fitted width, in pixels: a percentage width
          // makes the grid track grow with the image instead of scrolling.
          if (stage.classList.contains('is-zoomed')) {
            stage.classList.remove('is-zoomed');
            big.style.width = '';
          } else {
            var w = big.getBoundingClientRect().width;
            stage.classList.add('is-zoomed');
            big.style.width = Math.round(w * 2) + 'px';
          }
        });
        box.addEventListener('click', function (e) {
          if (e.target === box || e.target === stage || e.target.classList.contains('lightbox__bar')) close();
        });
        document.addEventListener('keydown', function (e) {
          if (box.hidden) return;
          if (e.key === 'Escape') { e.preventDefault(); close(); }
          else if (e.key === 'ArrowLeft' && items.length > 1) { e.preventDefault(); show(current - 1); }
          else if (e.key === 'ArrowRight' && items.length > 1) { e.preventDefault(); show(current + 1); }
          else if (e.key === 'Tab') {
            var f = Array.prototype.filter.call(box.querySelectorAll('a[href], button'), function (el) { return !el.hidden; });
            var first = f[0], last = f[f.length - 1];
            if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
            else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
            else if (!box.contains(document.activeElement)) { e.preventDefault(); first.focus(); }
          }
        });
      })();
    </script>
  </body>
</html>
