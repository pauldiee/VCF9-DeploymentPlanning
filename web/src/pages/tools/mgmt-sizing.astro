---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { OPTIONS, WORKBOOK_REVISION } from '../../lib/mgmt-sizing';

// Server-render the <option> lists from the shared engine so the dropdowns
// never drift from the calculation tables.
const opt = (values: readonly string[]) => values;
---

<BaseLayout
  title="Management Domain Sizing & Fit Check | VCF 9.1 Planning"
  description="Interactive VCF 9.1 management-domain sizing calculator with a cluster fit check: does your proposed host count and spec fit the fleet at N-1?"
  active="tools/mgmt-sizing"
>
  <article class="sizer">
    <header class="sizer__head">
      <p class="itq-eyebrow">Sizing tool</p>
      <h1>Management Domain Sizing &amp; Fit Check</h1>
      <p class="sizer__lede">
        Reproduces the Broadcom <em>Planning &amp; Preparation Workbook</em>
        (<strong>{WORKBOOK_REVISION}</strong>) <em>Management Domain Sizing</em> sheet, and adds the
        check the spreadsheet lacks: enter the cluster you intend to build and see whether the
        fleet <strong>fits at N-1</strong>, and where the headroom is. Everything runs in your
        browser; nothing is sent anywhere.
      </p>
      <div class="sizer__toolbar">
        <button type="button" id="btnShare"><i class="fa-solid fa-link" aria-hidden="true"></i> Copy share link</button>
        <button type="button" id="btnSummary"><i class="fa-solid fa-clipboard-list" aria-hidden="true"></i> Copy summary</button>
        <button type="button" id="btnExport"><i class="fa-solid fa-download" aria-hidden="true"></i> Export</button>
        <label class="sizer__filebtn"><i class="fa-solid fa-upload" aria-hidden="true"></i> Import<input type="file" id="fileImport" accept="application/json,.json" hidden /></label>
        <button type="button" id="btnReset"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Reset</button>
        <span id="toolbarMsg" class="sizer__toolbar-msg" role="status"></span>
      </div>
      <details class="sizer__profiles" open>
        <summary>Deployment profiles at a glance</summary>
        <table class="sizer__table">
          <thead><tr><th>Profile</th><th>What it deploys</th><th>Fits</th><th>Reference fleet*</th></tr></thead>
          <tbody>
            <tr><td><strong>Simple</strong> (Small)</td><td>Single NSX Manager, 1 services-runtime control node, single-node VCF Operations and VCF Automation — no management-plane HA</td><td>Labs, edge and small sites</td><td>76 vCPU · 251 GB · 7.4 TB</td></tr>
            <tr><td><strong>HA-Small</strong></td><td>3 NSX Managers, 3 control nodes, a <strong>2-node</strong> VCF Operations cluster, single-node VCF Automation — HA layout on the small appliance sizes</td><td>The cheapest HA: no single points of failure in the core management plane</td><td>106 vCPU · 335 GB · 8.4 TB</td></tr>
            <tr><td><strong>HA-Medium</strong></td><td>Medium vCenter, 3-node VCF Operations and VCF Automation</td><td>Typical production fleet</td><td>184 vCPU · 656 GB · 11.4 TB</td></tr>
            <tr><td><strong>HA-Large</strong></td><td>Large vCenter (XLarge storage) and NSX Managers, 3-node VCF Operations and VCF Automation on Large</td><td>Large fleets, many workload domains</td><td>298 vCPU · 949 GB · 15.4 TB</td></tr>
          </tbody>
        </table>
        <p class="sizer__hint">* Management domain with VCF Operations, Cloud Proxy and VCF Automation, before workload domains and Day-N services — Broadcom's <a href="https://techdocs.broadcom.com/us/en/vmware-cis/vcf/vcf-9-0-and-later/9-1/design/vmware-cloud-foundation-concepts/vcf-fleet-sizing-models-9-x.html">VCF Fleet Sizing Models</a>, which this tool reproduces exactly.</p>
      </details>
    </header>

    <div class="sizer__grid">
      <!-- ================= INPUTS ================= -->
      <section class="sizer__inputs">
        <fieldset>
          <legend>Deployment profile</legend>
          <label>Deployment model
            <select id="deploymentModel">{opt(OPTIONS.deploymentModel).map((v) => <option>{v}</option>)}</select>
          </label>
          <label>Deployment size
            <select id="deploymentSize">{opt(OPTIONS.deploymentSize).map((v) => <option>{v}</option>)}</select>
          </label>
          <p class="sizer__hint">Simple deploys at Small only; High Availability at Small, Medium or Large.</p>
          <label>Instance model
            <select id="instanceModel">{opt(OPTIONS.instanceModel).map((v) => <option>{v}</option>)}</select>
          </label>
          <label>Principal storage
            <select id="storageType">{opt(OPTIONS.storageType).map((v) => <option>{v}</option>)}</select>
          </label>
        </fieldset>

        <fieldset>
          <legend>Advanced management domain sizing</legend>
          <label class="sizer__check"><input id="advanced" type="checkbox" /> Override the profile-derived sizes</label>
          <p class="sizer__hint">The workbook's <em>Advanced Management Domain Sizing</em>: pick the management vCenter, NSX Manager, VCF Operations, Cloud Proxy and VCF Automation sizes yourself instead of taking them from the profile.</p>
          <div id="advancedFields" hidden>
            <label>Management vCenter size
              <select id="advVcenterSize">{opt(OPTIONS.vcenterSize).map((v) => <option>{v}</option>)}</select>
            </label>
            <label>Management vCenter storage
              <select id="advVcenterStorage">{opt(OPTIONS.vcenterStorage).map((v) => <option>{v}</option>)}</select>
            </label>
            <label>NSX Manager model
              <select id="advNsxModel">{opt(OPTIONS.advNsxModel).map((v) => <option>{v}</option>)}</select>
            </label>
            <label>NSX Manager size
              <select id="advNsxSize">{opt(OPTIONS.advNsxSize).map((v) => <option>{v}</option>)}</select>
            </label>
            <label>VCF Operations model
              <select id="advVcfOpsModel">{opt(OPTIONS.advVcfOpsModel).map((v) => <option>{v}</option>)}</select>
            </label>
            <label>VCF Operations size
              <select id="advVcfOpsSize">{opt(OPTIONS.advVcfOpsSize).map((v) => <option>{v}</option>)}</select>
            </label>
            <label>Cloud Proxy size
              <select id="advCollectorSize">{opt(OPTIONS.advCollectorSize).map((v) => <option>{v}</option>)}</select>
            </label>
            <label>VCF Automation size
              <select id="advVcfaSize">{opt(OPTIONS.advVcfaSize).map((v) => <option>{v}</option>)}</select>
            </label>
            <p class="sizer__hint">While this is on, VCF Operations, its Cloud Proxy and VCF Automation follow these choices (Exclude removes them); the NSX Manager model also sets the host minimum (4 for an HA cluster).</p>
          </div>
        </fieldset>

        <fieldset>
          <legend>Proposed cluster &amp; host spec</legend>
          <label>Cluster type
            <select id="clusterType">{opt(OPTIONS.clusterType).map((v) => <option>{v}</option>)}</select>
          </label>
          <p class="sizer__hint" id="stretchHint" hidden>The stretched <strong>×2 mirror is vSAN only</strong>. With NFS / FC stretched (vSphere Metro Storage Cluster), replication between sites is done by the storage array and is not modelled here — enter the datastore capacity available to the management cluster.</p>
          <label>Number of hosts
            <input id="proposedHosts" type="number" min="1" step="1" />
          </label>
          <label>Cores per host
            <input id="coresPerHost" type="number" min="1" step="1" />
          </label>
          <label>RAM per host (GB)
            <input id="ramPerHost" type="number" min="1" step="1" />
          </label>
          <div id="vsanCapacity">
            <label><span id="capacityDisksText">Capacity disks per host</span>
              <input id="capacityDisksPerHost" type="number" min="0" step="1" />
            </label>
            <label>Capacity disk size (GB)
              <input id="capacityDiskSizeGb" type="number" min="0" step="10" />
            </label>
            <p class="sizer__hint" id="capacityHint"></p>
            <p class="sizer__hint" id="perHostRawOut"></p>
          </div>
          <label id="externalCapacity" hidden>Available datastore capacity (GB)
            <input id="externalStorageGb" type="number" min="0" step="100" />
          </label>
          <label>CPU oversubscription (X:1)
            <input id="cpuOver" type="number" min="1" step="0.5" />
          </label>
          <label>RAM oversubscription (X:1)
            <input id="ramOver" type="number" min="1" step="0.5" />
          </label>
          <p class="sizer__warn" id="oversubWarn" hidden></p>
          <label>vSAN rebuild + operations reserve (%) <span class="sizer__tag">vSAN only</span>
            <input id="reservePct" type="number" min="0" step="1" />
          </label>
          <p class="sizer__hint" id="reserveHint" hidden>Not applied to NFS / FC — only the storage growth % is added on top of VM disk + swap.</p>
          <label>Storage growth (%)
            <input id="growthPct" type="number" min="0" step="1" />
          </label>
        </fieldset>

        <fieldset>
          <legend>Management components</legend>
          <p class="sizer__hint" id="derivedSizes"></p>
          <label>NSX Global Manager
            <select id="nsxGmSize">{opt(OPTIONS.nsxGmSize).map((v) => <option>{v}</option>)}</select>
          </label>
          <label>NSX Edges / Virtual Network Appliances
            <select id="nsxEdgeSize">{opt(OPTIONS.nsxEdgeSize).map((v) => <option>{v}</option>)}</select>
          </label>
          <label>vSphere Supervisor on the management domain
            <select id="supervisorMode">{opt(OPTIONS.supervisorMode).map((v) => <option>{v}</option>)}</select>
          </label>
          <label id="supervisorSizeLabel" hidden>Supervisor control plane size
            <select id="supervisorSize">{opt(OPTIONS.supervisorSize).map((v) => <option>{v}</option>)}</select>
          </label>
          <p class="sizer__hint">Counts the Supervisor control plane VMs (1 or 3). An Edge-backed Supervisor (VPC + Centralized Transit Gateway, or classic NSX) also needs its Edge cluster at <strong>Large</strong> minimum; the VPC + Distributed Transit Gateway path uses a VNA cluster and no Edge.</p>
          <p class="sizer__warn" id="edgeWarn" hidden></p>
          <label>Avi Load Balancer
            <select id="aviSize">{opt(OPTIONS.aviSize).map((v) => <option>{v}</option>)}</select>
          </label>
          <label>Security Services Platform
            <select id="ssp">{opt(OPTIONS.ssp).map((v) => <option>{v}</option>)}</select>
          </label>
          <p class="sizer__hint">Sized by the management NSX Manager size; one SSP Installer is added per five SSP deployments (management + workload domains).</p>
          <label class="sizer__check"><input id="licenseHub" type="checkbox" /> License Hub (vDefend / Avi licensing)</label>
          <p class="sizer__hint">Needed for vDefend. For Avi only with on-prem licensing — an Avi Controller can use Cloud Licensing directly with the Avi Cloud Console instead.</p>
        </fieldset>

        <fieldset>
          <legend>VCF fleet components</legend>
          <label>VCF Operations
            <select id="vcfOps">{opt(OPTIONS.vcfOps).map((v) => <option>{v}</option>)}</select>
          </label>
          <p class="sizer__hint"><strong>Include</strong> deploys it here (HA-Small 2 nodes, HA-Medium / Large 3, Simple 1) with its Cloud Proxy and, on a first instance, the License Server. <strong>Existing</strong> reuses an instance elsewhere: only the Cloud Proxy and License Server are counted.</p>
          <label class="sizer__check"><input id="vcfOpsCollector" type="checkbox" /> Cloud Proxy without VCF Operations here</label>
          <label class="sizer__check"><input id="vcfAutomation" type="checkbox" /> VCF Automation</label>
          <label id="vcfAutomationSizeLabel" hidden>VCF Automation size
            <select id="vcfAutomationSize">{opt(OPTIONS.vcfAutomationSize).map((v) => <option>{v}</option>)}</select>
            <span class="sizer__hint">Automation's own size sets the node count: Small = 1 node, Medium / Large = 3. The workbook uses the profile size.</span>
          </label>
          <label>VCF Operations for Networks
            <select id="opsNetSize">{opt(OPTIONS.opsNetSize).map((v) => <option>{v}</option>)}</select>
          </label>
          <p class="sizer__hint">Platform node on a first instance; the collector is counted on every instance.</p>
        </fieldset>

        <fieldset>
          <legend>VCF management services</legend>
          <p class="sizer__hint">These run on the VCF services runtime, so they do not add rows of their own: they raise the <strong>worker node count</strong> (and, with Log Management or Real-time Metrics on a first instance, the worker size).</p>
          <label>Log Management size
            <select id="logsSize">{opt(OPTIONS.logsSize).map((v) => <option>{v}</option>)}</select>
          </label>
          <label id="logsReplicasLabel" hidden>Log Management replicas
            <input id="logsReplicas" type="number" min="1" step="1" />
            <span class="sizer__hint">Min Small 1 / Medium 3 / Large 6, max 19.</span>
          </label>
          <label class="sizer__check"><input id="vcfRtm" type="checkbox" /> Real-time Metrics</label>
          <label class="sizer__check"><input id="vcfSd" type="checkbox" /> Software Depot (additional instance)</label>
          <label class="sizer__check"><input id="vcfIdb" type="checkbox" /> Identity Broker (additional instance)</label>
          <p class="sizer__hint" id="workerOut"></p>
        </fieldset>

        <fieldset>
          <legend>Protection blueprints</legend>
          <label>Site Protection &amp; Disaster Recovery
            <select id="spr">{opt(OPTIONS.spr).map((v) => <option>{v}</option>)}</select>
          </label>
          <p class="sizer__hint">One VMware Live Recovery appliance for the management domain, plus one per workload domain marked for DR below.</p>
          <label class="sizer__check"><input id="rwr" type="checkbox" /> On-premises Ransomware Recovery</label>
        </fieldset>

        <fieldset>
          <legend>Workload domains
            <button type="button" id="addWld" class="sizer__add">+ Add workload domain</button>
          </legend>
          <p class="sizer__hint">Each workload domain's vCenter, dedicated NSX Managers, Global Managers,
            Avi controllers and SSP run inside the management domain, so they add to its footprint.</p>
          <div id="wldList"></div>
        </fieldset>
      </section>

      <!-- ================= RESULTS ================= -->
      <section class="sizer__results">
        <div id="verdict" class="verdict"></div>

        <h2>Fit against your cluster</h2>
        <table class="sizer__table" id="fitTable">
          <thead><tr><th>Dimension</th><th>Fleet needs</th><th>Cluster offers</th><th>Headroom</th><th></th></tr></thead>
          <tbody></tbody>
        </table>
        <p class="sizer__hint">CPU and RAM are checked against the tolerated failure: <strong>N-1</strong> (one host)
          for a standard cluster, or <strong>N/2</strong> (the surviving AZ must run everything) for a stretched
          cluster. For <strong>vSAN</strong>, storage rebuild is covered by the reserve %, and stretched mirrors a
          full copy per AZ. For <strong>NFS / FC</strong>, storage is checked against the datastore capacity you enter;
          resilience and replication are the array's job.</p>

        <h2>Fleet requirement</h2>
        <dl class="sizer__stats" id="stats"></dl>

        <details class="sizer__detail">
          <summary>Component footprint (<span id="compCount">0</span> line items)</summary>
          <table class="sizer__table" id="compTable">
            <thead><tr><th>Component</th><th>Nodes</th><th>vCPU</th><th>RAM&nbsp;GB</th><th>Disk&nbsp;GB</th></tr></thead>
            <tbody></tbody>
          </table>
        </details>

        <details class="sizer__detail">
          <summary id="breakdownTitle">vSAN raw capacity breakdown</summary>
          <dl class="sizer__stats" id="vsanTable"></dl>
        </details>
      </section>
    </div>

    <p class="sizer__source">
      Figures transcribed from <code>reference/vcf-9.1.1-planning-and-preparation-workbook.xlsx</code>
      ({WORKBOOK_REVISION}), sheet <em>Management Domain Sizing</em>. This is a planning aid;
      always confirm the final numbers against the official workbook for your revision.
    </p>
  </article>
</BaseLayout>

<script>
  import { OPTIONS, WORKBOOK_REVISION, defaultState, compute, migrateState, deploymentSizeOptions, logsReplicaMin, LOGS_REPLICA_MAX, supervisorEdgeWarning, type SizingState, type WorkloadDomain } from '../../lib/mgmt-sizing';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const state: SizingState = defaultState();

  const selOptions = (values: readonly string[], selected: string) =>
    values.map((v) => `<option${v === selected ? ' selected' : ''}>${v}</option>`).join('');

  // ---- bind top-level inputs to state ----
  const numIds = ['proposedHosts', 'coresPerHost', 'ramPerHost', 'capacityDisksPerHost', 'capacityDiskSizeGb', 'externalStorageGb', 'cpuOver', 'ramOver', 'reservePct', 'growthPct', 'logsReplicas'] as const;
  const selIds = ['deploymentModel', 'deploymentSize', 'instanceModel', 'storageType', 'clusterType', 'nsxGmSize', 'nsxEdgeSize', 'supervisorMode', 'supervisorSize', 'aviSize', 'ssp', 'vcfOps', 'opsNetSize', 'logsSize', 'vcfAutomationSize', 'spr', 'advVcenterSize', 'advVcenterStorage', 'advNsxModel', 'advNsxSize', 'advVcfOpsModel', 'advVcfOpsSize', 'advCollectorSize', 'advVcfaSize'] as const;
  const chkIds = ['licenseHub', 'vcfOpsCollector', 'vcfAutomation', 'vcfRtm', 'vcfSd', 'vcfIdb', 'rwr', 'advanced'] as const;

  function hydrate() {
    for (const id of numIds) ($(id) as HTMLInputElement).value = String((state as any)[id]);
    for (const id of selIds) ($(id) as HTMLSelectElement).value = String((state as any)[id]);
    for (const id of chkIds) ($(id) as HTMLInputElement).checked = Boolean((state as any)[id]);
  }

  function readInputs() {
    for (const id of numIds) (state as any)[id] = parseFloat(($(id) as HTMLInputElement).value) || 0;
    for (const id of selIds) (state as any)[id] = ($(id) as HTMLSelectElement).value;
    for (const id of chkIds) (state as any)[id] = ($(id) as HTMLInputElement).checked;
  }

  // ---- workload domain repeater ----
  function renderWlds() {
    const host = $('wldList');
    host.innerHTML = '';
    state.workloadDomains.forEach((w, i) => {
      const row = document.createElement('div');
      row.className = 'wld';
      const field = (label: string, key: string, opts: readonly string[], val: string) =>
        `<label class="wld__field">${label}<select data-i="${i}" data-k="${key}">${selOptions(opts, val)}</select></label>`;
      row.innerHTML = `
        <div class="wld__head">
          <span class="wld__badge">WLD ${i + 1}</span>
          <input class="wld__name" data-i="${i}" data-k="name" placeholder="Workload domain name (optional)" value="${w.name}" />
          <button type="button" class="wld__del" data-i="${i}" aria-label="Remove workload domain">&times;</button>
        </div>
        <div class="wld__fields">
          ${field('vCenter size', 'vcenterSize', OPTIONS.vcenterSize, w.vcenterSize)}
          ${field('vCenter storage', 'vcenterStorage', OPTIONS.vcenterStorage, w.vcenterStorage)}
          ${field('NSX model', 'nsxModel', OPTIONS.nsxModel, w.nsxModel)}
          ${field('NSX Manager size', 'nsxSize', OPTIONS.nsxManagerSize, w.nsxSize)}
          ${field('Global Manager', 'gm', OPTIONS.gm, w.gm)}
          ${field('Global Manager size', 'gmSize', OPTIONS.nsxManagerSize, w.gmSize)}
          ${field('Avi Load Balancer', 'aviSize', OPTIONS.aviSize, w.aviSize)}
          ${field('NSX Edge form factor', 'nsxEdgeSize', OPTIONS.nsxEdgeSize, w.nsxEdgeSize)}
        </div>
        <label class="sizer__check wld__check"><input type="checkbox" data-i="${i}" data-k="ssp" ${w.ssp ? 'checked' : ''} /> Security Services Platform in this domain</label>
        <label class="sizer__check wld__check"><input type="checkbox" data-i="${i}" data-k="spr" ${w.spr ? 'checked' : ''} /> Covered by Site Protection &amp; DR</label>
        <label class="sizer__check wld__check"><input type="checkbox" data-i="${i}" data-k="supervisorPlanned" ${w.supervisorPlanned ? 'checked' : ''} /> vSphere Supervisor planned on this domain</label>
        <p class="sizer__hint wld__hint">Advisory: the Edge cluster runs on this domain's hosts, so it is <strong>not</strong> added to the management-domain totals above — the check only enforces the Large minimum an Edge-backed Supervisor needs.</p>
        <p class="sizer__warn wld__warn" data-i="${i}" hidden></p>`;
      host.appendChild(row);
    });
    host.querySelectorAll<HTMLElement>('input,select').forEach((el) =>
      el.addEventListener('input', (e) => {
        const t = e.target as HTMLInputElement;
        const i = Number(t.dataset.i);
        (state.workloadDomains[i] as any)[t.dataset.k as keyof WorkloadDomain] =
          t.type === 'checkbox' ? t.checked : t.value;
        recalc();
      }),
    );
    host.querySelectorAll<HTMLButtonElement>('.wld__del').forEach((b) =>
      b.addEventListener('click', () => {
        state.workloadDomains.splice(Number(b.dataset.i), 1);
        renderWlds();
        recalc();
      }),
    );
  }

  $('addWld').addEventListener('click', () => {
    state.workloadDomains.push({ name: '', vcenterSize: 'Small', vcenterStorage: 'Default', nsxModel: 'Dedicated - HA Cluster', nsxSize: 'Medium', gm: 'Excluded', gmSize: 'Medium', aviSize: 'Excluded', ssp: false, spr: false, supervisorPlanned: false, nsxEdgeSize: 'Excluded' });
    renderWlds();
    recalc();
  });

  // Per-WLD Supervisor / Edge warning. The WLD rows persist between recalcs
  // (renderWlds only runs on add/remove), so refresh the banners here each pass.
  function renderWldWarnings() {
    state.workloadDomains.forEach((w, i) => {
      const el = document.querySelector<HTMLElement>(`.wld__warn[data-i="${i}"]`);
      if (!el) return;
      const msg = supervisorEdgeWarning(w.supervisorPlanned, w.nsxEdgeSize);
      el.hidden = !msg;
      if (msg) el.innerHTML = `⚠ ${msg}`;
    });
  }

  // ---- deployment size is constrained by the model (workbook E22 list):
  //   Simple -> Small only; High Availability -> Small, Medium or Large.
  let lastModel = '';
  function syncSizeOptions() {
    const model = ($('deploymentModel') as HTMLSelectElement).value;
    const allowed = deploymentSizeOptions(model);
    const sel = $('deploymentSize') as HTMLSelectElement;
    const current = allowed.includes(sel.value) ? sel.value : allowed[0];
    sel.innerHTML = selOptions(allowed, current);
    sel.disabled = allowed.length < 2;
    state.deploymentSize = current;
  }

  // ---- storage capacity input depends on the storage type ----
  let lastStorage = '';
  function syncStorageInputs() {
    const t = ($('storageType') as HTMLSelectElement).value;
    const vsan = t === 'vSAN-ESA' || t === 'vSAN-OSA';
    ($('vsanCapacity') as HTMLElement).hidden = !vsan;
    ($('externalCapacity') as HTMLElement).hidden = vsan;
    ($('reservePct') as HTMLInputElement).disabled = !vsan;
    ($('reserveHint') as HTMLElement).hidden = vsan;
    if (vsan) {
      $('capacityDisksText').textContent = t === 'vSAN-ESA' ? 'Storage devices per host' : 'Capacity disks per host';
      $('capacityHint').textContent = t === 'vSAN-ESA'
        ? 'ESA: every NVMe device in the storage pool counts toward capacity.'
        : 'OSA: capacity-tier disks only; the cache device per disk group does not add usable capacity.';
    }
  }

  // ---- Log Management: any size, on any instance (workbook 9.1.1, Static
  // Reference Tables row 393); the replica count is constrained by the size.
  let lastLogsSize = '';
  function syncLogsReplicas() {
    const size = ($('logsSize') as HTMLSelectElement).value;
    const rep = $('logsReplicas') as HTMLInputElement;
    const min = logsReplicaMin(size);
    rep.min = String(min);
    rep.max = String(LOGS_REPLICA_MAX);
    const v = Math.min(LOGS_REPLICA_MAX, Math.max(min, parseFloat(rep.value) || min));
    rep.value = String(v);
    state.logsReplicas = v;
  }

  // ---- rendering ----
  const gb = (n: number) => n.toLocaleString('en-US');
  const pct = (n: number) => (n === Infinity ? 'n/a' : `${n >= 0 ? '+' : ''}${n.toFixed(0)}%`);
  // vSAN-only steps (FTT, rebuild/ops reserve, stretched x2 mirror) must not be
  // labelled as if they applied to NFS / FC principal storage.
  const isVsanType = (t: string) => t === 'vSAN-ESA' || t === 'vSAN-OSA';
  const storageLabel = (t: string) => (isVsanType(t) ? 'vSAN raw (GB)' : 'Datastore capacity (GB)');

  function recalc() {
    const model = ($('deploymentModel') as HTMLSelectElement).value;
    if (model !== lastModel) {
      lastModel = model;
      syncSizeOptions();
    }
    const storage = ($('storageType') as HTMLSelectElement).value;
    if (storage !== lastStorage) {
      lastStorage = storage;
      syncStorageInputs();
    }
    // Log Management replicas track the logs size.
    const logsSize = ($('logsSize') as HTMLSelectElement).value;
    if (logsSize !== lastLogsSize) {
      lastLogsSize = logsSize;
      syncLogsReplicas();
    }
    readInputs();
    const r = compute(state);

    // verdict banner
    const v = $('verdict');
    v.className = `verdict ${r.fit.overall ? 'verdict--ok' : 'verdict--bad'}`;
    const survives = state.clusterType === 'Standard' ? 'one host failure' : 'a full AZ (site) failure';
    v.innerHTML = r.fit.overall
      ? `<strong>Fits.</strong> ${state.proposedHosts} × host survives ${survives} with room to spare. Tightest dimension: ${r.fit.binding}.`
      : `<strong>Does not fit.</strong> Shortfall on <strong>${r.fit.binding}</strong> (survivability basis: ${r.survivorBasis}). Minimum hosts for this fleet &amp; spec: <strong>${r.requiredHosts}</strong>.`;

    // fit table
    const rows: Array<[string, string, string, ReturnType<typeof compute>['fit']['cpu']]> = [
      [`CPU (vCPU, ${r.survivorBasis})`, `${gb(r.fit.cpu.required)}`, `${gb(r.fit.cpu.available)}`, r.fit.cpu],
      [`RAM (GB, ${r.survivorBasis})`, `${gb(r.fit.ram.required)}`, `${gb(r.fit.ram.available)}`, r.fit.ram],
      [storageLabel(state.storageType), `${gb(r.fit.storage.required)}`, `${gb(r.fit.storage.available)}`, r.fit.storage],
      ['Host count', `${r.fit.hosts.required}`, `${r.fit.hosts.available}`, r.fit.hosts],
    ];
    $('fitTable').querySelector('tbody')!.innerHTML = rows
      .map(([label, req, avail, d]) =>
        `<tr class="${d.fits ? 'ok' : 'bad'}"><td>${label}</td><td>${req}</td><td>${avail}</td><td>${pct(d.headroomPct)}</td><td>${d.fits ? '✓' : '✗'}</td></tr>`,
      )
      .join('');

    // fleet stats
    $('stats').innerHTML = [
      ['Total nodes (VMs)', gb(r.totals.nodes)],
      ['Total vCPU', gb(r.totals.cpu)],
      ['Total RAM', `${gb(r.totals.ram)} GB`],
      ['Total VM disk', `${gb(r.totals.disk)} GB`],
      ['Minimum hosts', r.requiredHosts > r.workbookHosts ? `${r.requiredHosts} (workbook ${r.workbookHosts})` : `${r.requiredHosts}`],
      ['vCPU / host (N-1)', r.perHostN1 ? gb(r.perHostN1.cpu) : 'n/a'],
      ['RAM / host (N-1)', r.perHostN1 ? `${gb(r.perHostN1.ram)} GB` : 'n/a'],
      ['Storage / host (N-1)', !isVsanType(state.storageType) ? 'n/a (shared datastore)' : r.perHostN1 ? `${gb(r.perHostN1.storage)} GB` : 'n/a'],
    ].map(([k, val]) => `<div><dt>${k}</dt><dd>${val}</dd></div>`).join('');

    // component table
    $('compCount').textContent = String(r.components.length);
    $('compTable').querySelector('tbody')!.innerHTML = r.components
      .map((c) => `<tr><td>${c.name}</td><td>${c.nodes}</td><td>${gb(c.cpu)}</td><td>${gb(c.ram)}</td><td>${gb(c.disk)}</td></tr>`)
      .join('');

    // Log Management replicas only apply when a size is chosen
    ($('logsReplicasLabel') as HTMLElement).hidden = state.logsSize === 'Exclude';

    // VCF Automation size only applies when Automation is included (and not in
    // advanced mode, where the advanced size decides)
    ($('vcfAutomationSizeLabel') as HTMLElement).hidden = !state.vcfAutomation || state.advanced;
    ($('vcfAutomation') as HTMLInputElement).disabled = state.advanced;
    ($('advancedFields') as HTMLElement).hidden = !state.advanced;
    // Supervisor size only applies when a Supervisor is included
    ($('supervisorSizeLabel') as HTMLElement).hidden = state.supervisorMode === 'Excluded';
    // Additional-instance-only services
    ($('vcfSd') as HTMLInputElement).disabled = state.instanceModel !== 'Additional Instance';
    ($('vcfIdb') as HTMLInputElement).disabled = state.instanceModel !== 'Additional Instance';
    // Services-runtime worker readout
    $('workerOut').innerHTML = `Services runtime: <strong>${r.workers.nodes} worker nodes</strong> × ${r.workers.perNodeCpu} vCPU / ${r.workers.perNodeRam} GB.`;

    // Oversubscription guardrail — the workbook caps the recommendation at 2:1
    const over = Math.max(state.cpuOver, state.ramOver);
    const warn = $('oversubWarn') as HTMLElement;
    warn.hidden = over <= 2;
    if (!warn.hidden) {
      const which = state.cpuOver > 2 && state.ramOver > 2 ? 'CPU and RAM' : state.cpuOver > 2 ? 'CPU' : 'RAM';
      warn.innerHTML = `⚠ ${which} oversubscription is above <strong>2:1</strong>. Broadcom's guidance caps the management domain at <strong>2:1</strong> to keep the latency-sensitive control plane performant; higher ratios shrink the host count here but are not a recommended posture. Monitor closely and add hardware if you see contention.`;
    }

    // vSphere Supervisor needs its Edge cluster at Large form factor minimum —
    // management domain, then each workload domain.
    const edgeWarnEl = $('edgeWarn') as HTMLElement;
    const ew = supervisorEdgeWarning(state.supervisorMode !== 'Excluded', state.nsxEdgeSize);
    edgeWarnEl.hidden = !ew;
    if (ew) edgeWarnEl.innerHTML = `⚠ ${ew}`;
    renderWldWarnings();

    // derived (profile-fixed) component sizes
    $('derivedSizes').innerHTML = `${state.advanced ? 'Set in advanced sizing' : 'Fixed by the deployment profile'}: management vCenter <strong>${r.derived.vcenterSize}</strong> ` +
      `(<strong>${r.derived.vcenterStorage}</strong> storage), NSX Local Manager <strong>${r.derived.nsxManagerSize}</strong>. ` +
      `The options below are your genuine choices.`;

    // derived per-host raw readout
    const rawOut = $('perHostRawOut');
    rawOut.textContent = r.perHostRaw > 0
      ? `= ${gb(r.perHostRaw)} GB raw per host → ${gb(r.storageAvailable)} GB across ${state.proposedHosts} hosts.`
      : '';

    // capacity breakdown — vSAN shows its FTT / reserve / mirror steps; NFS / FC
    // only VM disk + swap + growth, so no step reads as if it had been applied.
    const vsanStore = isVsanType(state.storageType);
    const stretchedStore = state.clusterType !== 'Standard';
    ($('stretchHint') as HTMLElement).hidden = vsanStore || !stretchedStore;
    $('breakdownTitle').textContent = vsanStore ? 'vSAN raw capacity breakdown' : 'Datastore capacity breakdown (NFS / FC)';
    const fttFactor = state.storageType === 'vSAN-ESA' ? '×1.5, ESA' : '×2, OSA';
    const breakdown: Array<[string, string]> = vsanStore
      ? [
          ['VM capacity (disk)', `${gb(r.vsan.vmCapacity)} GB`],
          ['Swap reservation', `${gb(r.vsan.swap)} GB`],
          ['Interim total', `${gb(r.vsan.interim)} GB`],
          [`After FTT redundancy (${fttFactor})`, `${gb(r.vsan.redundancy)} GB`],
          [`After rebuild + ops reserve (+${state.reservePct}%)`, `${gb(r.vsan.reserve)} GB`],
          [`After growth (+${state.growthPct}%)`, `${gb(r.vsan.growth)} GB`],
          ...(stretchedStore ? [['After stretched mirror (×2)', `${gb(r.vsan.raw)} GB`] as [string, string]] : []),
          ['Raw capacity required', `${gb(r.vsan.raw)} GB`],
        ]
      : [
          ['VM capacity (disk)', `${gb(r.vsan.vmCapacity)} GB`],
          ['Swap reservation', `${gb(r.vsan.swap)} GB`],
          ['Interim total', `${gb(r.vsan.interim)} GB`],
          [`After growth (+${state.growthPct}%)`, `${gb(r.vsan.growth)} GB`],
          ['Datastore capacity required', `${gb(r.vsan.raw)} GB`],
        ];
    $('vsanTable').innerHTML = breakdown.map(([k, val]) => `<div><dt>${k}</dt><dd>${val}</dd></div>`).join('');
  }

  // ---- export / import / share ----
  // Enum-valued top-level fields get the same allow-list validation as the
  // per-WLD fields — a crafted import / share hash must not produce undefined
  // table lookups (NaN totals) or select values that don't exist.
  const TOP_ENUMS: Partial<Record<keyof SizingState, readonly string[]>> = {
    deploymentModel: OPTIONS.deploymentModel,
    deploymentSize: OPTIONS.deploymentSize,
    instanceModel: OPTIONS.instanceModel,
    storageType: OPTIONS.storageType,
    clusterType: OPTIONS.clusterType,
    nsxGmSize: OPTIONS.nsxGmSize,
    nsxEdgeSize: OPTIONS.nsxEdgeSize,
    supervisorMode: OPTIONS.supervisorMode,
    supervisorSize: OPTIONS.supervisorSize,
    aviSize: OPTIONS.aviSize,
    ssp: OPTIONS.ssp,
    vcfOps: OPTIONS.vcfOps,
    opsNetSize: OPTIONS.opsNetSize,
    logsSize: OPTIONS.logsSize,
    vcfAutomationSize: OPTIONS.vcfAutomationSize,
    spr: OPTIONS.spr,
    advVcenterSize: OPTIONS.vcenterSize,
    advVcenterStorage: OPTIONS.vcenterStorage,
    advNsxModel: OPTIONS.advNsxModel,
    advNsxSize: OPTIONS.advNsxSize,
    advVcfOpsModel: OPTIONS.advVcfOpsModel,
    advVcfOpsSize: OPTIONS.advVcfOpsSize,
    advCollectorSize: OPTIONS.advCollectorSize,
    advVcfaSize: OPTIONS.advVcfaSize,
  };
  function sanitize(obj: any): SizingState {
    const out = defaultState();
    if (!obj || typeof obj !== 'object') return out;
    obj = migrateState(obj); // plans saved by the v1.9.1.001 version of the tool
    for (const k of Object.keys(out) as (keyof SizingState)[]) {
      if (k === 'workloadDomains') continue;
      const v = (obj as any)[k];
      if (v === undefined || typeof v !== typeof (out as any)[k]) continue;
      const allowed = TOP_ENUMS[k];
      if (allowed && !allowed.includes(v)) continue;
      (out as any)[k] = v;
    }
    const inList = (arr: readonly string[], v: any, d: string) => (arr.includes(v) ? v : d);
    if (Array.isArray(obj.workloadDomains)) {
      out.workloadDomains = obj.workloadDomains.slice(0, 24).map((w: any) => ({
        name: typeof w?.name === 'string' ? w.name.slice(0, 60) : '',
        vcenterSize: inList(OPTIONS.vcenterSize, w?.vcenterSize, 'Small'),
        vcenterStorage: inList(OPTIONS.vcenterStorage, w?.vcenterStorage, 'Default'),
        nsxModel: inList(OPTIONS.nsxModel, w?.nsxModel, 'Dedicated - HA Cluster'),
        nsxSize: inList(OPTIONS.nsxManagerSize, w?.nsxSize, 'Medium'),
        gm: inList(OPTIONS.gm, w?.gm, 'Excluded'),
        gmSize: inList(OPTIONS.nsxManagerSize, w?.gmSize, 'Medium'),
        aviSize: inList(OPTIONS.aviSize, w?.aviSize, 'Excluded'),
        ssp: typeof w?.ssp === 'boolean' ? w.ssp : false,
        spr: typeof w?.spr === 'boolean' ? w.spr : false,
        supervisorPlanned: typeof w?.supervisorPlanned === 'boolean' ? w.supervisorPlanned : false,
        nsxEdgeSize: inList(OPTIONS.nsxEdgeSize, w?.nsxEdgeSize, 'Excluded'),
      }));
    }
    return out;
  }

  function loadState(obj: any) {
    Object.assign(state, sanitize(obj));
    // reset dependent-dropdown guards so recalc re-runs every sync for the new state
    lastModel = lastStorage = lastLogsSize = '';
    // expand the constrained dropdowns to their full option lists so hydrate's
    // values stick; recalc's syncs then re-constrain them for the loaded profile
    ($('deploymentSize') as HTMLSelectElement).innerHTML = selOptions([...OPTIONS.deploymentSize], state.deploymentSize);
    ($('logsSize') as HTMLSelectElement).innerHTML = selOptions([...OPTIONS.logsSize], state.logsSize);
    hydrate();
    renderWlds();
    recalc();
  }

  const b64enc = (s: string) => btoa(unescape(encodeURIComponent(s)));
  const b64dec = (s: string) => decodeURIComponent(escape(atob(s)));
  function toolbarMsg(msg: string) {
    const el = $('toolbarMsg');
    el.textContent = msg;
    setTimeout(() => { if (el.textContent === msg) el.textContent = ''; }, 2500);
  }

  $('btnShare').addEventListener('click', async () => {
    const hash = '#s=' + b64enc(JSON.stringify(state));
    history.replaceState(null, '', hash);
    const url = location.origin + location.pathname + hash;
    try { await navigator.clipboard.writeText(url); toolbarMsg('Share link copied'); }
    catch { toolbarMsg('Link is in the address bar (copy blocked)'); }
  });
  function buildSummary(): string {
    readInputs();
    const r = compute(state);
    const s = state;
    const store = (s.storageType === 'vSAN-ESA' || s.storageType === 'vSAN-OSA')
      ? `${s.capacityDisksPerHost}×${gb(s.capacityDiskSizeGb)} GB/host`
      : `${gb(s.externalStorageGb)} GB datastore`;
    const dim = (label: string, d: ReturnType<typeof compute>['fit']['cpu']) =>
      `| ${label} | ${gb(d.required)} | ${gb(d.available)} | ${pct(d.headroomPct)} | ${d.fits ? '✓' : '✗'} |`;
    // Supervisor / Edge advisory lines — management domain, then each WLD that plans one.
    const supLines: string[] = [];
    const mgmtSup = supervisorEdgeWarning(s.supervisorMode !== 'Excluded', s.nsxEdgeSize);
    if (mgmtSup) supLines.push(`- ⚠ Management domain: ${mgmtSup}`);
    else if (s.supervisorMode !== 'Excluded') supLines.push(`- Management domain: Supervisor (${s.supervisorMode}, ${s.supervisorSize}) counted; NSX Edge selection meets the Large minimum.`);
    s.workloadDomains.forEach((w, i) => {
      const label = w.name?.trim() || `Workload Domain ${i + 1}`;
      const wmsg = supervisorEdgeWarning(w.supervisorPlanned, w.nsxEdgeSize);
      if (wmsg) supLines.push(`- ⚠ ${label}: ${wmsg}`);
      else if (w.supervisorPlanned) supLines.push(`- ${label}: Supervisor planned; NSX Edge form factor meets the Large minimum (Edge runs on WLD hosts, not counted here).`);
    });
    const L = [
      '# VCF 9.1 Management Domain Sizing',
      '',
      `**Profile:** ${s.deploymentModel} / ${s.deploymentSize}, ${s.instanceModel}, ${s.storageType}`,
      `**Cluster:** ${s.clusterType}, ${s.proposedHosts} hosts × ${s.coresPerHost} cores / ${gb(s.ramPerHost)} GB RAM / ${store}`,
      `**Assumptions:** CPU ${s.cpuOver}:1, RAM ${s.ramOver}:1, ${isVsanType(s.storageType) ? `vSAN reserve ${s.reservePct}%` : 'vSAN reserve n/a (NFS / FC)'}, growth ${s.growthPct}%`,
      `**${s.advanced ? 'Advanced sizing' : 'Profile-fixed'}:** vCenter ${r.derived.vcenterSize} (${r.derived.vcenterStorage} storage), NSX Local Manager ${r.derived.nsxManagerSize}${r.derived.nsxHaCluster ? ' ×3' : ' ×1'}`,
      ...(supLines.length ? ['', '## vSphere Supervisor / Edge', ...supLines] : []),
      '',
      `## Fit: ${r.fit.overall ? '✅ FITS' : '❌ DOES NOT FIT'} (tightest: ${r.fit.binding}, basis: ${r.survivorBasis})`,
      '',
      '| Dimension | Fleet needs | Cluster offers | Headroom | Fits |',
      '| --- | ---: | ---: | ---: | :-: |',
      dim(`CPU (vCPU, ${r.survivorBasis})`, r.fit.cpu),
      dim(`RAM (GB, ${r.survivorBasis})`, r.fit.ram),
      dim(storageLabel(s.storageType), r.fit.storage),
      dim('Host count', r.fit.hosts),
      '',
      '## Fleet requirement',
      `- Totals: ${gb(r.totals.nodes)} nodes, ${gb(r.totals.cpu)} vCPU, ${gb(r.totals.ram)} GB RAM, ${gb(r.totals.disk)} GB disk`,
      `- Minimum hosts: ${r.requiredHosts}${r.requiredHosts > r.workbookHosts ? ` (workbook ${r.workbookHosts})` : ''}`,
      `- Services runtime: ${r.workers.nodes} workers × ${r.workers.perNodeCpu} vCPU / ${r.workers.perNodeRam} GB`,
      ...(r.perHostN1 ? [`- Per host (N-1): ${gb(r.perHostN1.cpu)} vCPU, ${gb(r.perHostN1.ram)} GB RAM, ${gb(r.perHostN1.storage)} GB`] : []),
      `- ${isVsanType(s.storageType) ? 'vSAN raw' : 'Datastore capacity'} required: ${gb(r.vsan.raw)} GB`,
      '',
      '## Components',
      ...r.components.map((c) => `- ${c.name}: ${c.nodes} node${c.nodes === 1 ? '' : 's'}, ${gb(c.cpu)} vCPU, ${gb(c.ram)} GB, ${gb(c.disk)} GB`),
      '',
      `_Generated with the ITQ VCF 9.1 Management Domain sizing tool (workbook ${WORKBOOK_REVISION})._`,
    ];
    return L.join('\n');
  }
  $('btnSummary').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(buildSummary()); toolbarMsg('Summary copied (Markdown)'); }
    catch { toolbarMsg('Copy failed (clipboard blocked)'); }
  });
  $('btnExport').addEventListener('click', () => {
    const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'mgmt-domain-sizing.json';
    a.click();
    URL.revokeObjectURL(a.href);
    toolbarMsg('Exported mgmt-domain-sizing.json');
  });
  $('fileImport').addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      try { loadState(JSON.parse(String(reader.result))); toolbarMsg(`Imported ${file.name}`); }
      catch { toolbarMsg('Import failed: not valid sizer JSON'); }
    };
    reader.readAsText(file);
    input.value = '';
  });
  $('btnReset').addEventListener('click', () => { loadState(defaultState()); toolbarMsg('Reset to defaults'); });

  function loadFromHash(): boolean {
    const m = location.hash.match(/[#&]s=([^&]+)/);
    if (!m) return false;
    try { loadState(JSON.parse(b64dec(m[1]))); return true; } catch { return false; }
  }

  for (const id of [...numIds, ...selIds, ...chkIds]) $(id).addEventListener('input', recalc);
  // Guard the Log Management replica field: clamp to the per-size min..19 on
  // commit (blur / enter / spinner) so an out-of-range typed value can't stick.
  $('logsReplicas').addEventListener('change', () => { syncLogsReplicas(); recalc(); });
  if (!loadFromHash()) {
    hydrate();
    renderWlds();
    recalc();
  }
</script>

<style is:global>
  .sizer { max-width: 1100px; }
  .sizer__head h1 { margin: 0.2rem 0 0.6rem; }
  .sizer__lede { color: var(--text-muted); max-width: 70ch; }
  .sizer__profiles { margin-top: 1rem; }
  .sizer__profiles summary { cursor: pointer; font-weight: 600; margin-bottom: 0.4rem; }
  .sizer__profiles .sizer__table td:first-child { white-space: nowrap; }
  .sizer__toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-top: 0.9rem; }
  .sizer__toolbar button, .sizer__toolbar .sizer__filebtn {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font: inherit; font-size: 0.8rem; padding: 0.35rem 0.75rem;
    border: var(--border-width) solid var(--border-default); border-radius: var(--radius-sm);
    background: var(--surface-card); color: var(--text-body); cursor: pointer;
  }
  .sizer__toolbar button:hover, .sizer__toolbar .sizer__filebtn:hover { border-color: var(--itq-orange); color: var(--itq-orange); }
  .sizer__toolbar-msg { font-size: 0.78rem; color: var(--itq-orange); font-weight: var(--fw-semibold); }
  .sizer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-6, 1.5rem);
    align-items: start;
  }
  @media (max-width: 900px) { .sizer__grid { grid-template-columns: 1fr; } }

  .sizer fieldset {
    border: var(--border-width) solid var(--border-default);
    border-radius: var(--radius-sm);
    padding: 0.9rem 1rem 1rem;
    margin: 0 0 1rem;
  }
  .sizer legend {
    font-weight: var(--fw-semibold);
    color: var(--text-body);
    padding: 0 0.4rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .sizer label { display: block; font-size: 0.85rem; margin: 0.45rem 0; color: var(--text-muted); }
  .sizer label.sizer__check { display: flex; align-items: center; gap: 0.5rem; color: var(--text-body); }
  .sizer select, .sizer input[type='number'], .sizer input.wld__name {
    display: block;
    width: 100%;
    margin-top: 0.2rem;
    padding: 0.4rem 0.5rem;
    border: var(--border-width) solid var(--border-default);
    border-radius: var(--radius-sm);
    font: inherit;
    background: var(--surface-card);
  }
  .sizer input[type='checkbox'] { width: auto; accent-color: var(--itq-orange); }
  .sizer__add {
    margin-left: auto;
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    border: var(--border-width) solid var(--itq-orange);
    color: var(--itq-orange);
    background: transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .sizer__add:hover { background: var(--itq-orange); color: var(--itq-white); }
  .sizer__hint { font-size: 0.78rem; color: var(--text-muted); margin: 0.3rem 0 0.6rem; }
  .sizer__tag { display: inline-block; font-size: 0.68rem; font-weight: 600; line-height: 1.4; padding: 0 0.4rem; margin-left: 0.25rem; border-radius: 999px; border: 1px solid currentColor; color: var(--text-muted); vertical-align: middle; }
  input:disabled { opacity: 0.5; cursor: not-allowed; }
  .sizer__warn {
    font-size: 0.8rem;
    margin: 0.2rem 0 0.6rem;
    padding: 0.5rem 0.7rem;
    background: var(--status-warn-bg);
    border-left: 3px solid var(--status-warn-border);
    border-radius: var(--radius-sm);
    color: var(--status-warn-text);
  }

  .wld {
    border: var(--border-width) solid var(--border-default);
    border-radius: var(--radius-sm);
    background: var(--surface-subtle);
    padding: 0.6rem 0.7rem;
    margin-bottom: 0.6rem;
  }
  .wld__head { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.55rem; }
  .wld__badge {
    flex: none;
    font-size: 0.68rem;
    font-weight: var(--fw-semibold);
    color: var(--text-on-chip-brand);
    background: var(--surface-chip-brand);
    border-radius: var(--radius-sm);
    padding: 0.15rem 0.45rem;
    letter-spacing: 0.02em;
  }
  .wld .wld__name { flex: 1; margin-top: 0; font-size: 0.82rem; }
  .wld__del {
    flex: none;
    border: var(--border-width) solid var(--border-default);
    background: var(--surface-card); color: var(--text-body);
    border-radius: var(--radius-sm); width: 1.7rem; height: 1.7rem;
    cursor: pointer; font-size: 1rem; line-height: 1;
  }
  .wld__del:hover { background: var(--itq-orange); color: var(--itq-white); border-color: var(--itq-orange); }
  .wld__fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.4rem 0.6rem;
  }
  .wld .wld__field { display: block; margin: 0; font-size: 0.72rem; color: var(--text-muted); }
  .wld .wld__field select { margin-top: 0.15rem; font-size: 0.8rem; padding: 0.32rem; }
  .wld .wld__check { font-size: 0.78rem; margin-top: 0.6rem; color: var(--text-body); }
  .wld .wld__hint { margin: 0.25rem 0 0; }
  .wld .wld__warn { font-size: 0.76rem; margin-top: 0.4rem; }

  .sizer__results { position: sticky; top: calc(var(--header-h) + 1rem); }
  .verdict {
    padding: 0.8rem 1rem;
    border-radius: var(--radius-sm);
    border-left: 4px solid;
    margin-bottom: 1.2rem;
    font-size: 0.95rem;
  }
  .verdict--ok { background: var(--status-ok-bg); border-color: var(--status-ok-border); color: var(--status-ok-text); }
  .verdict--bad { background: var(--status-bad-bg); border-color: var(--status-bad-border); color: var(--status-bad-text); }

  .sizer__results h2 { font-size: 1.05rem; margin: 1.3rem 0 0.5rem; color: var(--text-body); }
