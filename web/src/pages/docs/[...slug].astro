---
import { getCollection } from 'astro:content';
import DocPage from '../../components/DocPage.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  // Which docs have a Dutch translation (pilot, #290) — feeds the header toggle.
  const nlSlugs = (await getCollection('docsNl')).map((d) => d.id);
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: { doc, nlSlugs },
  }));
}

const { doc, nlSlugs } = Astro.props;
---

<DocPage doc={doc} lang="en" nlSlugs={nlSlugs} />
