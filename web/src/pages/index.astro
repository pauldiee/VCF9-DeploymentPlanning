---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NAV } from '../nav';
import { docHref as href, withBase } from '../lib/path';

const flowItems = NAV.filter((item) => item.step !== 'Reference');
const referenceItems = NAV.filter((item) => item.step === 'Reference');

const TOOLS = [
  {
    href: withBase('tools/mgmt-sizing/'),
    icon: 'calculator',
    step: 'Interactive',
    label: 'Sizing Calculator',
    blurb: 'Size the management fleet and check whether your hosts fit at N-1; export or share the result.',
  },
  {
    href: withBase('tools/deployment-plan/'),
    icon: 'sitemap',
    step: 'Interactive',
    label: 'Deployment Plan Export',
    blurb: 'Build your deployment scope (connectivity, storage, stretch, Supervisor, Automation model, Day-2) and export a backlog.',
  },
  {
    href: withBase('tools/plan-tracker/'),
    icon: 'bars-progress',
    step: 'Interactive',
    label: 'Deployment Tracker',
    blurb: 'The exported plan as a checklist, with per-epic progress and a save/load progress file.',
  },
  {
    href: withBase('tools/test-plan/'),
    icon: 'clipboard-check',
    step: 'Interactive',
    label: 'Test Plan',
    blurb: 'Scope-driven verification cases in phases TP-0 through TP-6, with result tracking and report/CSV/runbook export.',
  },
  {
    href: withBase('version-overview/'),
    icon: 'layer-group',
    step: 'Live',
    label: 'VCF 9.1 Version Overview',
    blurb: 'Auto-updating latest version and build per component, refreshed weekly from Broadcom.',
  },
];
---

<BaseLayout
  title="VCF 9.1 Deployment Planning"
  description="A field guide to the VMware Cloud Foundation 9.1 Planning and Preparation Workbook: lock the network plan first, run a role-based intake, fill the workbook last."
  fullWidth
>
  <section class="hero">
    <div class="hero__inner">
      <p class="itq-eyebrow hero__eyebrow">Hybrid Cloud &middot; VMware Cloud Foundation 9.1</p>
      <h1 class="hero__title">
        Plan the VCF 9 build <span class="accent">before</span> you open the workbook.
      </h1>
      <p class="hero__intro itq-intro">
        The official Broadcom Planning and Preparation Workbook has hundreds of fields across
        nine technical sheets. Opened cold, it produces gaps, wrong VLANs, and
        weeks of back-and-forth. This guide flips the order: lock the network and DNS plan
        first, run a role-based intake, then fill the workbook last, when it is mechanical.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={href('prerequisites')}>
          Start with the prerequisites <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
        <a
          class="btn btn--ghost"
          href="https://github.com/pauldiee/VCF9-DeploymentPlanning"
          target="_blank"
          rel="noopener"
        >
          <i class="fa-brands fa-github" aria-hidden="true"></i> View the repo
        </a>
      </div>
    </div>
  </section>

  <section class="workflow">
    <div class="workflow__inner">
      <p class="itq-eyebrow">The flow</p>
      <h2 class="workflow__heading">The planning flow, in order</h2>
      <div class="card-grid">
        {
          flowItems.map((item) => (
            <a class="planning-card" href={href(item.slug)}>
              <div class="planning-card__top">
                <i class={`fa-solid fa-${item.icon} planning-card__icon`} aria-hidden="true" />
              </div>
              <span class="planning-card__step itq-eyebrow">{item.step}</span>
              <h3 class="planning-card__title">{item.label}</h3>
              <p class="planning-card__blurb">{item.blurb}</p>
              <span class="planning-card__cta">
                Open <i class="fa-solid fa-arrow-right" aria-hidden="true" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="workflow">
    <div class="workflow__inner">
      <p class="itq-eyebrow">Once you're building</p>
      <h2 class="workflow__heading">Interactive tools</h2>
      <div class="card-grid">
        {
          TOOLS.map((item) => (
            <a class="planning-card" href={item.href}>
              <div class="planning-card__top">
                <i class={`fa-solid fa-${item.icon} planning-card__icon`} aria-hidden="true" />
              </div>
              <span class="planning-card__step itq-eyebrow">{item.step}</span>
              <h3 class="planning-card__title">{item.label}</h3>
              <p class="planning-card__blurb">{item.blurb}</p>
              <span class="planning-card__cta">
                Open <i class="fa-solid fa-arrow-right" aria-hidden="true" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="workflow">
    <div class="workflow__inner">
      <p class="itq-eyebrow">Build guides</p>
      <h2 class="workflow__heading">Reference: per-component build guides</h2>
      <div class="card-grid">
        {
          referenceItems.map((item) => (
            <a class="planning-card" href={href(item.slug)}>
              <div class="planning-card__top">
                <i class={`fa-solid fa-${item.icon} planning-card__icon`} aria-hidden="true" />
              </div>
              <span class="planning-card__step itq-eyebrow">{item.step}</span>
              <h3 class="planning-card__title">{item.label}</h3>
              <p class="planning-card__blurb">{item.blurb}</p>
              <span class="planning-card__cta">
                Open <i class="fa-solid fa-arrow-right" aria-hidden="true" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="related">
    <div class="related__inner">
      <p class="itq-eyebrow">External tools</p>
      <h2 class="related__heading">Part of a larger VCF 9 toolkit</h2>
      <div class="related__grid">
        <a class="related__item" href="https://vcfplanner.lcoscia.fr/" target="_blank" rel="noopener">
          <h3>Coscia Network Planner</h3>
          <p>Generates a starter VCF 9 network design (VLANs, appliance IPs, FQDNs, VIPs) from a few inputs. Validate and own the result with Step 1.</p>
        </a>
        <a class="related__item" href="https://vcfplanning.lcoscia.fr/" target="_blank" rel="noopener">
          <h3>Coscia VCF Planner</h3>
          <p>A browser-based reimplementation of the workbook. Run the intake here, enter answers there.</p>
        </a>
        <a class="related__item" href="https://github.com/vmware/powershell-module-for-vmware-cloud-foundation-jsongenerator" target="_blank" rel="noopener">
          <h3>VCF.JSONGenerator</h3>
          <p>Ken Gould's PowerShell module that reads a filled P&amp;P workbook and generates the VCF deployment JSON.</p>
        </a>
        <a class="related__item" href="https://github.com/pauldiee/VCFHostPreparation" target="_blank" rel="noopener">
          <h3>VCFHostPreparation</h3>
          <p>Quickly image and commission ESXi hosts before bring-up: management, workload-domain, and second-AZ hosts.</p>
        </a>
        <a class="related__item" href="https://github.com/pauldiee/VCFJsonSpecCreators" target="_blank" rel="noopener">
          <h3>VCFJsonSpecCreators</h3>
          <p>Optional PowerShell that builds, validates, and submits the SDDC Manager API JSON for Day-N expansion: network pools, workload domains, clusters, and vSAN stretch.</p>
        </a>
        <div class="related__item related__item--service">
          <span class="related__tag">ITQ Consulting Services</span>
          <h3>VCF9 Readiness Assessment</h3>
          <p>Pre-cutover readiness scoring from RVTools and HST exports.</p>
        </div>
        <div class="related__item related__item--service">
          <span class="related__tag">ITQ Consulting Services</span>
          <h3>VCF Health Check</h3>
          <p>Post-cutover health checks of live VCF 9 environments.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
