---
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../data/vcf-versions.json';

// Data is refreshed daily by web/scripts/scrape-versions.mjs (a scheduled GitHub Action
// commits it back to main, which rebuilds Pages). See issues #179, #265.
// `lines` carries one component set per supported release line (9.1.1.x, 9.1.0.x); `addons`
// is the shared optional set (versions on its own schemes, not tied to the VCF maintenance
// version). See the script header for the X.Y.Z.EEHH version scheme.
const { _updated, _family, _sourceErrors, lines, addons } = data;

// Rows whose build came from a recorded human-verified reconciliation because the upstream
// release notes render a malformed build string (#214). Current, not stale - so these are
// footnoted, never folded into the "could not be read" warning above. Checked across all lines.
const pinned = lines.flatMap((ln) => ln.components).filter((c) => c.pinned);

// Group a component list by category, preserving manifest order within each group. Rows with a
// `parent` (the VCF Operations sub-components, #180) render indented beneath their parent as a
// visual grouping - independently-versioned components, not internal parts of one (#185).
const CAT_ORDER = ['Core', 'Operations', 'Automation', 'Management'];
function groupByCat(components) {
  return CAT_ORDER
    .map((cat) => {
      const rows = components.filter((c) => c.category === cat);
      const childrenOf = (key) => rows.filter((c) => c.parent === key);
      const ordered = [];
      for (const c of rows.filter((c) => !c.parent)) {
        ordered.push({ ...c, child: false });
        for (const ch of childrenOf(c.key)) ordered.push({ ...ch, child: true });
      }
      return { cat, rows: ordered };
    })
    .filter((g) => g.rows.length);
}

// One section per release line (newest maintenance version first), plus the shared add-ons.
const lineSections = lines.map((ln) => ({ ...ln, groups: groupByCat(ln.components) }));
const addonRows = addons.map((c) => ({ ...c, child: false }));

const fmtDate = (iso) =>
  iso ? new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' }) : '';
---

<BaseLayout
  title="VCF 9.1 Version Overview"
  active="version-overview"
  description="Current version and build for every VMware Cloud Foundation 9.1 component, per supported maintenance version (9.1.1, 9.1.0), refreshed daily from Broadcom."
>
  <article class="prose">
    <p class="doc-eyebrow itq-eyebrow">Reference</p>
    <h1>VCF {_family} Version Overview</h1>

    <p>
      The current latest version and build for each VMware Cloud Foundation {_family} component. In
      {' '}{_family}, components patch <strong>per component and asynchronously</strong> (Express
      Patches), so a single point-in-time table drifts within weeks. This one is refreshed
      automatically from Broadcom, so it stays honest as a one-glance &ldquo;what&rsquo;s
      current&rdquo; reference during planning.
    </p>

    <p class="vo-note">
      <strong>Reading a {_family.split('.')[0]}.x version.</strong> Broadcom numbers releases
      {' '}<code>X.Y.Z.EEHH.build</code> &mdash; major <code>.</code> minor <code>.</code>
      {' '}maintenance <code>.</code> (Express&nbsp;Patch + Hot&nbsp;Patch) <code>.</code> build.
      Moving <code>X.Y.Z</code> (e.g. 9.1.0 &rarr; 9.1.1) is an <strong>upgrade</strong> and follows
      a required update sequence; moving only <code>EEHH</code> (e.g. 9.1.0.0300 &rarr; 9.1.0.0400)
      is a <strong>patch</strong> with no sequence. Each maintenance version keeps receiving patches
      on its own line, so every currently-supported one is listed below.
    </p>

    <p class="vo-updated">
      <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
      Last updated <strong>{fmtDate(_updated)}</strong>
      <span class="vo-updated__note">&middot; refreshed daily from Broadcom</span>
    </p>

    {
      _sourceErrors && _sourceErrors.length > 0 && (
        <p class="vo-warn">
          <i class="fa-solid fa-triangle-exclamation" aria-hidden="true" />
          {_sourceErrors.length} source(s) could not be read on the last run; those rows show the
          last known value: {_sourceErrors.map((e) => e.key).join(', ')}.
        </p>
      )
    }

    {
      pinned.length > 0 && (
        <p class="vo-note vo-note--pin">
          <i class="fa-solid fa-circle-info" aria-hidden="true" />
          <strong>&dagger;</strong> {pinned.length === 1 ? 'One build is' : `${pinned.length} builds are`}{' '}
          shown from a <strong>human-verified value</strong> because Broadcom's release notes render
          it malformed ({pinned.map((c) => c.name).join(', ')}). The row is <em>current</em>, not
          stale &mdash; hover the &dagger; for what upstream prints. If Broadcom changes the string,
          the scrape stops trusting the pin and flags it instead.
        </p>
      )
    }

    {
      lineSections.map((ln) => (
        <>
          <h2 class="vo-line">VCF {ln.v}<span class="vo-line__meta">GA {fmtDate(ln.ga)}</span></h2>
          {!ln.hasPatchTree && (
            <p class="vo-note">
              Newly released &mdash; Broadcom has not opened a patch tree for {ln.v} yet, so every
              row is at its <span class="vo-pill">GA</span> build (from the {ln.v} Bill of
              Materials). Express Patches will land here as they ship.
            </p>
          )}
          {ln.groups.map((g) => (
            <>
              <h3 class="vo-cat">{g.cat}</h3>
              <figure class="table-scroll vo-table">
                <table>
                  <thead>
                    <tr>
                      <th>Component</th>
                      <th>Latest version</th>
                      <th>Build</th>
                      <th>Released</th>
                      <th>Source</th>
                    </tr>
                  </thead>
                  <tbody>
                    {g.rows.map((c) => (
                      <tr class={c.child ? 'vo-child' : undefined}>
                        <td class="vo-name">{c.name}</td>
                        <td class="vo-ver">
                          {c.version ?? ''}
                          {c.patched === false && <span class="vo-pill">GA</span>}
                        </td>
                        <td class="vo-build">
                          {c.build ?? 'N/A'}
                          {c.pinned && (
                            <sup
                              class="vo-pin"
                              title={`Broadcom's release notes render this build as "${c.pinned.raw}", which is malformed. Showing the verified build ${c.pinned.build} (checked ${c.pinned.verified}). ${c.pinned.note}`}
                            >
                              &dagger;
                            </sup>
                          )}
                        </td>
                        <td>{fmtDate(c.releaseDate)}</td>
                        <td>
                          {c.sourceUrl && (
                            <a href={c.sourceUrl} target="_blank" rel="noopener">
                              Release notes <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true" />
                            </a>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </figure>
            </>
          ))}
        </>
      ))
    }

    <h2 class="vo-line">Add-ons</h2>
    <p class="vo-note">
      Optional components, <strong>not part of the base VCF {_family} BOM</strong> and not tied to a
      maintenance version. Each patches on its own cadence and versioning scheme in its own
      release-notes tree. Avi Load Balancer publishes no build number, so its Build column shows
      &ldquo;N/A&rdquo;.
    </p>
    <figure class="table-scroll vo-table">
      <table>
        <thead>
          <tr>
            <th>Component</th>
            <th>Latest version</th>
            <th>Build</th>
            <th>Released</th>
            <th>Source</th>
          </tr>
        </thead>
        <tbody>
          {addonRows.map((c) => (
            <tr>
              <td class="vo-name">{c.name}</td>
              <td class="vo-ver">{c.version ?? ''}</td>
              <td class="vo-build">{c.build ?? 'N/A'}</td>
              <td>{fmtDate(c.releaseDate)}</td>
              <td>
                {c.sourceUrl && (
                  <a href={c.sourceUrl} target="_blank" rel="noopener">
                    Release notes <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true" />
                  </a>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </figure>

    <blockquote>
      <p>
        <strong>Always confirm with Broadcom before advising a build.</strong> Patch cadence is
        high and components move independently. Rows marked <span class="vo-pill">GA</span> have no
        Express Patch yet, so they run at their general-availability build. The VCF Operations
        services listed under Management &mdash; Orchestrator, Log Management, Real-Time Metrics and
        its Store &mdash; are independently-versioned components of that product family, each with
        its own build. The core fleet is read from the Broadcom TechDocs patch-release tree (or, for
        a line with no patch tree yet, that line's Bill of Materials), and each add-on from its own
        release-notes tree.
      </p>
    </blockquote>

    <p class="vo-src">
      Sources: <a href={data._sources.techdocs} target="_blank" rel="noopener">TechDocs patch releases</a>
      &middot; <a href="https://knowledge.broadcom.com/external/article/326316" target="_blank" rel="noopener">vCenter build KB</a>.
      Generated by <code>web/scripts/scrape-versions.mjs</code>.
    </p>
  </article>
</BaseLayout>

<style>
  .vo-updated {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: var(--space-3) var(--space-4);
    background: var(--surface-subtle);
    border-left: 4px solid var(--itq-orange);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-size: var(--fs-small);
  }
  .vo-updated__note { color: var(--text-muted); }

  .vo-warn {
    padding: var(--space-3) var(--space-4);
    background: var(--status-note-bg);
    border-left: 4px solid var(--itq-orange);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-size: var(--fs-small);
  }
  .vo-warn i { color: var(--itq-orange); margin-right: 0.4rem; }

  /* Release-line heading (VCF 9.1.1 / VCF 9.1.0 / Add-ons) - the top level of the page. */
  .vo-line {
    margin-top: var(--space-8);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--itq-orange);
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .vo-line__meta {
    font-size: var(--fs-small);
    font-weight: var(--fw-regular);
    color: var(--text-muted);
  }

  .vo-cat {
    margin-top: var(--space-6);
    font-size: var(--fs-h4, 1.1rem);
    color: var(--text-body);
  }
  .vo-table { margin-top: var(--space-3); }
  .vo-name { font-weight: var(--fw-semibold); white-space: normal; }
  .vo-ver { white-space: nowrap; }
  .vo-build { font-family: var(--font-mono); white-space: nowrap; }

  /* VCF Operations sub-components (#180): indented sub-rows under their parent (visual grouping). */
  .vo-child .vo-name {
    font-weight: var(--fw-regular);
    color: var(--text-muted);
    padding-left: 1.9rem;
    position: relative;
  }
  .vo-child .vo-name::before {
    content: "\21B3"; /* downwards arrow with tip rightwards */
    position: absolute;
    left: 0.7rem;
    color: var(--text-muted);
  }
  .vo-child .vo-ver, .vo-child .vo-build { color: var(--text-muted); }

  .vo-note {
    padding: var(--space-3) var(--space-4);
    background: var(--surface-subtle);
    border-left: 4px solid var(--text-muted);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-size: var(--fs-small);
    margin-top: var(--space-2);
  }

  /* Informational, deliberately NOT the orange warning treatment: a pinned row is
     current and verified, so it must not read as a failure (#214). Quieter than
     body text on purpose - it used to name an undefined token (--itq-royal) and
     so silently inherited the body colour, drawing no distinction at all (#234). */
  .vo-note--pin {
    margin-bottom: var(--space-4);
  }
  .vo-note--pin i {
    color: var(--text-muted);
    margin-right: 0.4rem;
  }
  .vo-pin {
    color: var(--text-muted);
    cursor: help;
    font-weight: 700;
    margin-left: 0.15rem;
  }

  .vo-pill {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.05rem 0.4rem;
    font-size: 0.7rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.03em;
    color: var(--text-body);
    background: var(--surface-tag);
    border-radius: var(--radius-sm);
    vertical-align: middle;
  }
  .vo-src { font-size: var(--fs-small); color: var(--text-muted); }
</style>
