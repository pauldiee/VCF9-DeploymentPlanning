---
import BaseLayout from '../layouts/BaseLayout.astro';
import VersionLineTables from '../components/VersionLineTables.astro';
import data from '../data/vcf-versions.json';

// Data is refreshed daily by web/scripts/scrape-versions.mjs (a scheduled GitHub Action
// commits it back to main, which rebuilds Pages). See issues #179, #265.
// `lines` carries one component set per release line (9.1.1.x, 9.1.0.x, 9.0.2.x); `addons`
// is the shared optional set (versions on its own schemes, not tied to the VCF maintenance
// version). A line with `frozen` no longer receives patches (#486): it is shown collapsed at
// the end, with the reason and its source. See the script header for the X.Y.Z.EEHH scheme.
const { _updated, _sourceErrors, lines, addons } = data;

// Rows whose build came from a recorded human-verified reconciliation because the upstream
// release notes render a malformed build string (#214). Current, not stale - so these are
// footnoted, never folded into the "could not be read" warning above. Checked across all lines.
const pinned = lines.flatMap((ln) => ln.components).filter((c) => c.pinned);
// Rows whose build was reconciled against the VCF Download Tool depot listing (#391): TechDocs
// prints the wrong build, or the component patched without release notes. Also current.
const reconciled = lines.flatMap((ln) => ln.components.filter((c) => c.reconciled).map((c) => `${c.name} (${ln.v})`));

// Group a component list by category, preserving manifest order within each group. Rows with a
// `parent` (the VCF Operations sub-components, #180) render indented beneath their parent as a
// visual grouping - independently-versioned components, not internal parts of one (#185).
const CAT_ORDER = ['Core', 'Operations', 'Automation', 'Management'];
function groupByCat(components) {
  return CAT_ORDER
    .map((cat) => {
      const rows = components.filter((c) => c.category === cat);
      const childrenOf = (key) => rows.filter((c) => c.parent === key);
      const ordered = [];
      for (const c of rows.filter((c) => !c.parent)) {
        ordered.push({ ...c, child: false });
        for (const ch of childrenOf(c.key)) ordered.push({ ...ch, child: true });
      }
      return { cat, rows: ordered };
    })
    .filter((g) => g.rows.length);
}

// One section per patched release line (newest first: 9.1.1, 9.0.2), then the lines that no
// longer receive patches (collapsed), then the shared add-ons.
const lineSections = lines.map((ln) => ({ ...ln, groups: groupByCat(ln.components) }));
const activeLines = lineSections.filter((ln) => !ln.frozen);
const frozenLines = lineSections.filter((ln) => ln.frozen);
const activeNames = activeLines.map((ln) => ln.v).join(' and ');
// Tools (#390: PowerCLI, VCF SDK) come from package feeds, not release notes - own section.
const addonRows = addons.filter((c) => c.category !== 'Tools');
const toolRows = addons.filter((c) => c.category === 'Tools');

const fmtDate = (iso) =>
  iso ? new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' }) : '';
---

<BaseLayout
  title="VCF 9 Version Overview"
  active="version-overview"
  description="Current version and build for every VMware Cloud Foundation 9.1.1 and 9.0.2 component, refreshed daily from Broadcom; 9.1.0 is shown as no longer patched."
>
  <article class="prose">
    <p class="doc-eyebrow itq-eyebrow">Reference</p>
    <h1>VCF 9 Version Overview</h1>

    <p>
      The current latest version and build for each VMware Cloud Foundation 9 component, for the
      release lines that still receive patches ({activeNames}). In VCF 9, components patch
      {' '}<strong>per component and asynchronously</strong> (Express Patches), so a single
      point-in-time table drifts within weeks. This one is refreshed automatically from Broadcom,
      so it stays honest as a one-glance &ldquo;what&rsquo;s current&rdquo; reference during
      planning.
    </p>

    <p class="vo-note">
      <strong>Reading a 9.x version.</strong> Broadcom numbers releases
      {' '}<code>X.Y.Z.EEHH.build</code> &mdash; major <code>.</code> minor <code>.</code>
      {' '}maintenance <code>.</code> (Express&nbsp;Patch + Hot&nbsp;Patch) <code>.</code> build.
      Moving <code>X.Y.Z</code> (e.g. 9.1.0 &rarr; 9.1.1) is an <strong>upgrade</strong> and follows
      a required update sequence; moving only <code>EEHH</code> (e.g. 9.1.0.0300 &rarr; 9.1.0.0400)
      is a <strong>patch</strong> with no sequence. Patches go to the <strong>newest maintenance
      version of each minor</strong>: today {activeNames}. An older maintenance version stops
      receiving them once its successor ships, so a fleet on it has to upgrade to get a fix
      {frozenLines.length > 0 && <> (see {frozenLines.map((ln) => ln.v).join(', ')} at the end)</>}.
      Broadcom states no written policy for this; it is what the security advisories and patch
      trees show.
    </p>

    <p class="vo-updated">
      <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
      Last updated <strong>{fmtDate(_updated)}</strong>
      <span class="vo-updated__note">&middot; refreshed daily from Broadcom</span>
    </p>

    {
      _sourceErrors && _sourceErrors.length > 0 && (
        <p class="vo-warn">
          <i class="fa-solid fa-triangle-exclamation" aria-hidden="true" />
          {_sourceErrors.length} source(s) could not be read on the last run; those rows show the
          last known value: {_sourceErrors.map((e) => e.key).join(', ')}.
        </p>
      )
    }

    {
      pinned.length > 0 && (
        <p class="vo-note vo-note--pin">
          <i class="fa-solid fa-circle-info" aria-hidden="true" />
          <strong>&dagger;</strong> {pinned.length === 1 ? 'One build is' : `${pinned.length} builds are`}{' '}
          shown from a <strong>human-verified value</strong> because Broadcom's release notes render
          it malformed ({pinned.map((c) => c.name).join(', ')}). The row is <em>current</em>, not
          stale &mdash; hover the &dagger; for what upstream prints. If Broadcom changes the string,
          the scrape stops trusting the pin and flags it instead.
        </p>
      )
    }

    {
      reconciled.length > 0 && (
        <p class="vo-note vo-note--pin">
          <i class="fa-solid fa-circle-info" aria-hidden="true" />
          <strong>&Dagger;</strong> {reconciled.length === 1 ? 'One build is' : `${reconciled.length} builds are`}{' '}
          taken from the <strong>VCF Download Tool depot listing</strong>, because Broadcom&rsquo;s
          release notes either print a different component&rsquo;s build or don&rsquo;t cover the
          patch at all ({reconciled.join(', ')}). Hover the &Dagger; for what the release notes or
          Bill of Materials show. The override applies only while TechDocs still shows that exact
          value, so the next patch replaces it automatically.
        </p>
      )
    }

    {
      activeLines.map((ln) => (
        <>
          <h2 class="vo-line">VCF {ln.v}<span class="vo-line__meta">GA {fmtDate(ln.ga)}{ln.minor === '9.0' && ' · previous minor'}</span></h2>
          {!ln.hasPatchTree && (
            <p class="vo-note">
              Newly released &mdash; Broadcom has not opened a patch tree for {ln.v} yet, so every
              row is at its <span class="vo-pill">GA</span> build (from the {ln.v} Bill of
              Materials). Express Patches will land here as they ship.
            </p>
          )}
          {ln.minor === '9.0' && (
            <p class="vo-note">
              VCF 9.0 is the previous minor. Its last maintenance version, 9.0.2, still receives
              patches (for example vCenter 9.0.2.0200 on 19 Nov 2026). 9.0 has its own products in
              places: VCF Operations for logs and Fleet Management instead of 9.1&rsquo;s Log
              Management and Fleet / SDDC lifecycle. Rows marked <span class="vo-pill">GA</span>
              {' '}have had no 9.0.2 patch and run at the 9.0.2 Bill of Materials build.
            </p>
          )}
          <VersionLineTables groups={ln.groups} />
        </>
      ))
    }

    {
      frozenLines.map((ln) => (
        <details class="vo-frozen">
          <summary>
            <span class="vo-frozen__title">VCF {ln.v}</span>
            <span class="vo-line__meta">no longer patched &middot; last patch {fmtDate(ln.frozen.lastPatch)} &middot; GA {fmtDate(ln.ga)}</span>
          </summary>
          <p class="vo-warn">
            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true" />
            <strong>{ln.v} no longer receives patches.</strong> {ln.frozen.reason} (<a href={ln.frozen.sourceUrl} target="_blank" rel="noopener">{ln.frozen.sourceLabel}</a>,
            checked {fmtDate(ln.frozen.checked)}). A fleet on {ln.v} gets fixes by upgrading to
            {' '}<strong>{ln.frozen.upgradeTo}</strong>. The rows below are the last {ln.v} builds and are
            no longer refreshed.
          </p>
          <VersionLineTables groups={ln.groups} />
        </details>
      ))
    }

    <h2 class="vo-line">Add-ons</h2>
    <p class="vo-note">
      Optional components for VCF 9.1, <strong>not part of the base VCF BOM</strong> and not tied to a
      maintenance version. Each patches on its own cadence and versioning scheme in its own
      release-notes tree. Avi Load Balancer publishes no build number, so its Build column shows
      &ldquo;N/A&rdquo;.
    </p>
    <figure class="table-scroll vo-table">
      <table>
        <thead>
          <tr>
            <th>Component</th>
            <th>Latest version</th>
            <th>Build</th>
            <th>Released</th>
            <th>Source</th>
          </tr>
        </thead>
        <tbody>
          {addonRows.map((c) => (
            <tr>
              <td class="vo-name">{c.name}</td>
              <td class="vo-ver">{c.version ?? ''}</td>
              <td class="vo-build">{c.build ?? 'N/A'}</td>
              <td>{fmtDate(c.releaseDate)}</td>
              <td>
                {c.sourceUrl && (
                  <a href={c.sourceUrl} target="_blank" rel="noopener">
                    Release notes <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true" />
                  </a>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </figure>

    <h2 class="vo-line">Tools</h2>
    <p class="vo-note">
      Client-side tooling for scripting against VCF 9. Not in the BOM; versions are read from
      the package feeds you install from (PowerShell Gallery, PyPI). PowerCLI&rsquo;s build is the
      last field of its gallery version; the Python SDK publishes no build number.
    </p>
    <figure class="table-scroll vo-table">
      <table>
        <thead>
          <tr>
            <th>Component</th>
            <th>Latest version</th>
            <th>Build</th>
            <th>Released</th>
            <th>Source</th>
          </tr>
        </thead>
        <tbody>
          {toolRows.map((c) => (
            <tr>
              <td class="vo-name">{c.name}</td>
              <td class="vo-ver">{c.version ?? ''}</td>
              <td class="vo-build">{c.build ?? 'N/A'}</td>
              <td>{fmtDate(c.releaseDate)}</td>
              <td>
                {c.sourceUrl && (
                  <a href={c.sourceUrl} target="_blank" rel="noopener">
                    Package <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true" />
                  </a>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </figure>

    <blockquote>
      <p>
        <strong>Always confirm with Broadcom before advising a build.</strong> Patch cadence is
        high and components move independently. Rows marked <span class="vo-pill">GA</span> have no
        Express Patch yet, so they run at their general-availability build. On ESXi,
        {' '}<span class="vo-pill vo-pill--live">Live patch</span> or <span class="vo-pill">Reboot</span>
        {' '}is the release notes&rsquo; own &ldquo;Live Patchable&rdquo; flag for that patch; a host
        can still be blocked from live patching (DPU hosts, some driver modules; KB 419942 / KB 428958). The VCF Operations
        services listed under Management &mdash; Orchestrator, Log Management, Real-Time Metrics and
        its Store (9.1), and VCF Operations for logs and Fleet Management (9.0) &mdash; are
        independently-versioned components of that product family, each with its own build.
      </p>
    </blockquote>

    <p class="vo-src">
      Sources: the Broadcom
      <a href={data._sources.releaseNotes} target="_blank" rel="noopener">VCF 9.1</a> and
      {' '}<a href={data._sources.releaseNotes90} target="_blank" rel="noopener">VCF 9.0 release notes</a>
      &mdash; for each maintenance version, its patch-release tree (or, where no Express Patch has
      shipped, that version's Bill of Materials), plus each add-on's own release notes and, for the
      tools, the PowerShell Gallery and PyPI package feeds; for a line that is no longer patched,
      the security advisory named in its note. Every row
      links its exact source. Generated by <code>web/scripts/scrape-versions.mjs</code>, refreshed
      daily.
    </p>
  </article>
</BaseLayout>

<style is:global>
  /* is:global since #486: the tables render in components/VersionLineTables.astro. Every class
     is vo-prefixed, so nothing leaks into other pages. */
  .vo-updated {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: var(--space-3) var(--space-4);
    background: var(--surface-subtle);
    border-left: 4px solid var(--itq-orange);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-size: var(--fs-small);
  }
  .vo-updated__note { color: var(--text-muted); }

  .vo-warn {
    padding: var(--space-3) var(--space-4);
    background: var(--status-note-bg);
    border-left: 4px solid var(--itq-orange);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-size: var(--fs-small);
  }
  .vo-warn i { color: var(--itq-orange); margin-right: 0.4rem; }

  /* Release-line heading (VCF 9.1.1 / VCF 9.1.0 / Add-ons) - the top level of the page. */
  .vo-line {
    margin-top: var(--space-8);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--itq-orange);
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .vo-line__meta {
    font-size: var(--fs-small);
    font-weight: var(--fw-regular);
    color: var(--text-muted);
  }

  .vo-cat {
    margin-top: var(--space-6);
    font-size: var(--fs-h4, 1.1rem);
    color: var(--text-body);
  }
  .vo-table { margin-top: var(--space-3); }
  .vo-name { font-weight: var(--fw-semibold); white-space: normal; }
  .vo-ver { white-space: nowrap; }
  .vo-build { font-family: var(--font-mono); white-space: nowrap; }

  /* VCF Operations sub-components (#180): indented sub-rows under their parent (visual grouping). */
  .vo-child .vo-name {
    font-weight: var(--fw-regular);
    color: var(--text-muted);
    padding-left: 1.9rem;
    position: relative;
  }
  .vo-child .vo-name::before {
    content: "\21B3"; /* downwards arrow with tip rightwards */
    position: absolute;
    left: 0.7rem;
    color: var(--text-muted);
  }
  .vo-child .vo-ver, .vo-child .vo-build { color: var(--text-muted); }

  .vo-note {
    padding: var(--space-3) var(--space-4);
    background: var(--surface-subtle);
    border-left: 4px solid var(--text-muted);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-size: var(--fs-small);
    margin-top: var(--space-2);
  }

  /* Informational, deliberately NOT the orange warning treatment: a pinned row is
     current and verified, so it must not read as a failure (#214). Quieter than
     body text on purpose - it used to name an undefined token (--itq-royal) and
     so silently inherited the body colour, drawing no distinction at all (#234). */
  .vo-note--pin {
    margin-bottom: var(--space-4);
  }
  .vo-note--pin i {
    color: var(--text-muted);
    margin-right: 0.4rem;
  }
  .vo-pin {
    color: var(--text-muted);
    cursor: help;
    font-weight: 700;
    margin-left: 0.15rem;
  }

  .vo-pill {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.05rem 0.4rem;
    font-size: 0.7rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.03em;
    color: var(--text-body);
    background: var(--surface-tag);
    border-radius: var(--radius-sm);
    vertical-align: middle;
  }
  /* A reboot-free ESX patch (#393): the brand chip, so it stands apart from the plain
     tag-coloured GA / Reboot pills without borrowing the orange warning treatment. */
  .vo-pill--live { background: var(--surface-chip-brand); color: #fff; }
  .vo-pill[title] { cursor: help; }
  .vo-src { font-size: var(--fs-small); color: var(--text-muted); }

  /* A release line that no longer receives patches (#486): collapsed, after the active lines. */
  .vo-frozen {
    margin-top: var(--space-8);
    border: 1px solid var(--surface-tag);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-4);
  }
  .vo-frozen > summary {
    cursor: pointer;
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding: var(--space-2) 0;
  }
  .vo-frozen__title { font-size: 1.3rem; font-weight: var(--fw-semibold); color: var(--text-muted); }
  .vo-frozen[open] > summary { border-bottom: 2px solid var(--text-muted); margin-bottom: var(--space-3); }
</style>
