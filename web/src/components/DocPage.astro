---
// One doc page, in either language. The English route (/docs/<slug>/) and the
// Dutch pilot route (/nl/docs/<slug>/, #290) both render through here, so the
// two cannot drift in layout. English is the default and the canonical text.
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { navBySlug } from '../nav';
import { docHref, docHrefNl } from '../lib/path';

interface Props {
  doc: CollectionEntry<'docs'> | CollectionEntry<'docsNl'>;
  lang?: 'en' | 'nl';
  /** Slugs that have a Dutch translation. */
  nlSlugs: string[];
  /** Dutch pages only: set when the English source changed after the translation was made. */
  stale?: { synced: string };
}

const { doc, lang = 'en', nlSlugs, stale } = Astro.props;
const { Content, headings } = await render(doc);
// Every heading level gets a TOC entry (not just H2) — nested by depth so the
// widget doubles as full in-page navigation, not just a section jump list.
const sections = headings.filter((h) => h.depth >= 2 && h.depth <= 4);

const hasNl = (slug: string) => nlSlugs.includes(slug);

const meta = navBySlug(doc.id);

const title = meta ? `${meta.label} — VCF 9 Deployment Planning and Operations` : 'VCF 9 Deployment Planning and Operations';

// The page in the other language, for the header toggle. An English page with
// no translation has none.
const altHref = lang === 'nl' ? docHref(doc.id) : hasNl(doc.id) ? docHrefNl(doc.id) : undefined;

const t =
  lang === 'nl'
    ? { toc: 'Op deze pagina' }
    : { toc: 'On this page' };
---

<BaseLayout title={title} description={meta?.blurb} active={doc.id} lang={lang} altHref={altHref}>
  {meta && <p class="doc-eyebrow itq-eyebrow">{meta.step}</p>}
  {
    stale && (
      <p class="nl-stale" role="note" data-pagefind-ignore>
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true" />
        <span>
          <strong>Deze vertaling loopt mogelijk achter.</strong> De Engelse versie is gewijzigd sinds deze
          vertaling is bijgewerkt ({stale.synced}). <a href={docHref(doc.id)}>Bekijk de Engelse versie</a>.
        </span>
      </p>
    )
  }
  <div class:list={['doc-body-grid', { 'doc-body-grid--no-toc': sections.length <= 2 }]}>
    <article class="doc prose">
      <Content />
    </article>

    {
      sections.length > 2 && (
        <aside class="doc-toc" aria-label={t.toc} data-pagefind-ignore>
          <span class="doc-toc__label">{t.toc}</span>
          <ul class="doc-toc__list">
            {sections.map((h) => (
              <li class={`doc-toc__item doc-toc__item--h${h.depth}`}>
                <a href={`#${h.slug}`} data-toc-target={h.slug}>
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</BaseLayout>

<style>
  .doc-body-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: var(--space-7);
    align-items: start;
  }
  .doc-body-grid--no-toc { grid-template-columns: minmax(0, 1fr); }

  /* Long docs list every heading level (#339), so the TOC can outgrow the
     viewport: cap it there and let it scroll on its own (#384). The scrollbar
     is hidden (it ate the narrow column's width); a bottom fade shows there
     is more, and the scroll-spy keeps the active entry in view. */
  .doc-toc {
    position: sticky;
    top: calc(var(--header-h) + var(--space-5));
    max-height: calc(100vh - var(--header-h) - var(--space-5) * 2);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    font-size: var(--fs-small);
  }
  .doc-toc::-webkit-scrollbar { display: none; }
  .doc-toc.has-more-below {
    mask-image: linear-gradient(to bottom, #000 calc(100% - 48px), transparent);
  }
  .doc-toc__label {
    display: block;
    font-weight: var(--fw-bold);
    font-size: var(--fs-eyebrow);
    text-transform: uppercase;
    letter-spacing: var(--ls-caps);
    color: var(--text-quiet);
    margin-bottom: var(--space-3);
  }
  .doc-toc__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* The ITQ tokens (base.css) draw a brand square on every ul > li::before. */
  .doc-toc__list li::before { display: none; }
  .doc-toc__list a {
    display: block;
    padding-left: var(--space-3);
    border-left: 2px solid var(--border-default);
    text-decoration: none;
    color: var(--text-muted);
    line-height: 1.4;
  }
  .doc-toc__list a:hover { color: var(--itq-orange); }
  .doc-toc__list a.is-active {
    color: var(--itq-orange);
    border-left-color: var(--itq-orange);
    font-weight: var(--fw-semibold);
  }
  /* H3/H4 nest under their H2 — same vertical line, indented text and a
     smaller/quieter treatment the deeper it goes. */
  .doc-toc__item--h3 a { padding-left: calc(var(--space-3) + 12px); font-size: 0.94em; }
  .doc-toc__item--h4 a { padding-left: calc(var(--space-3) + 24px); font-size: 0.88em; color: var(--text-quiet); }
  .doc-toc__item--h4 a:hover,
  .doc-toc__item--h4 a.is-active { color: var(--itq-orange); }

  /* Anchor targets inside the rendered markdown: keep headings clear of the sticky header */
  :global(.doc.prose h2),
  :global(.doc.prose h3),
  :global(.doc.prose h4) {
    scroll-margin-top: 90px;
  }

  /* Dutch pages: the English source moved on after this translation was made. */
  .nl-stale {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    margin: 0 0 var(--space-5);
    padding: var(--space-3) var(--space-4);
    border: var(--border-width) solid var(--itq-orange);
    border-radius: var(--radius-control);
    background: var(--surface-card);
    font-size: var(--fs-small);
  }
  .nl-stale i { color: var(--itq-orange); }

  @media (max-width: 900px) {
    .doc-body-grid { grid-template-columns: minmax(0, 1fr); }
    .doc-toc { display: none; }
  }
</style>

<script>
  // Scroll-spy: highlight the TOC entry for the section currently in view.
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.doc-toc__list a[data-toc-target]');
  if (tocLinks.length) {
    const tocBox = document.querySelector<HTMLElement>('.doc-toc');
    if (tocBox) {
      const updateFade = () =>
        tocBox.classList.toggle('has-more-below', tocBox.scrollTop + tocBox.clientHeight < tocBox.scrollHeight - 4);
      tocBox.addEventListener('scroll', updateFade, { passive: true });
      window.addEventListener('resize', updateFade);
      updateFade();
    }

    const sections = Array.from(tocLinks)
      .map((link) => document.getElementById(link.dataset.tocTarget ?? ''))
      .filter((el): el is HTMLElement => !!el);

    const setActive = (slug: string) => {
      tocLinks.forEach((link) => {
        const on = link.dataset.tocTarget === slug;
        link.classList.toggle('is-active', on);
        // Keep the active entry visible inside a TOC that scrolls on its own;
        // scroll only the TOC, never the page.
        if (on && tocBox) {
          const box = tocBox.getBoundingClientRect();
          const r = link.getBoundingClientRect();
          if (r.top < box.top || r.bottom > box.bottom) {
            tocBox.scrollBy({ top: r.top - box.top - box.height / 3, behavior: 'smooth' });
          }
        }
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible.length > 0) setActive(visible[0].target.id);
      },
      { rootMargin: '-100px 0px -70% 0px' }
    );
    sections.forEach((el) => observer.observe(el));
  }
</script>
